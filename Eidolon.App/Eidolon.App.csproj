<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Eidolon</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Eidolon.Core/Eidolon.Core.csproj" />
    <ProjectReference Include="../DataContainer/DataContainer.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Docs/ThirdPartyNotices.md" Link="ThirdPartyNotices.md" Visible="false" />
    <EmbeddedResource Include="../Datas/*.json" LogicalName="Eidolon.Datas.%(Filename)%(Extension)" Visible="false" />
    <Content Include="../Datas/*.json" Link="Datas\%(Filename)%(Extension)">
      <Visible>false</Visible>
      <CopyToOutputDirectory Condition="'$(Configuration)' != 'Release'">PreserveNewest</CopyToOutputDirectory>
      <CopyToOutputDirectory Condition="'$(Configuration)' == 'Release'">Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <AvaloniaResource Include="Assets\AppIcon.ico" />
    <AvaloniaResource Include="Assets\AppIcon.png" />
  </ItemGroup>
</Project>
