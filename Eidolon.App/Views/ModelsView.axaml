<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.ModelsView" x:DataType="vm:StudioViewModel">
  <Grid ColumnDefinitions="*,20,350" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,*" IsEnabled="{Binding IsIdle}">
            <StackPanel Spacing="8" Margin="8,0,0,18">
              <TextBlock Text="{DynamicResource EidolonText123}" Classes="title" />
              <TextBlock Text="{DynamicResource EidolonText124}" Classes="muted" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Content="{DynamicResource EidolonText125}" Command="{Binding ScanCommand}" />
                <Button Content="{DynamicResource EidolonText126}" Command="{Binding DownloadModelCommand}" />
              </StackPanel>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedAsset}" Background="{DynamicResource SurfaceBrush}" CornerRadius="12">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AssetItem">
                  <StackPanel Spacing="6" Margin="8,12">
                    <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <ScrollViewer Grid.Column="2">
            <Border Classes="card" IsEnabled="{Binding IsIdle}">
              <StackPanel Spacing="12">
                <TextBlock Text="{DynamicResource EidolonText127}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource EidolonText129}" Classes="label" />
                <ComboBox ItemsSource="{Binding AvailableFamilies}" SelectedItem="{Binding SelectedFamily}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FamilyChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{DynamicResource EidolonText130}" Classes="label" />
                <TextBox Text="{Binding AssetTrigger}" PlaceholderText="{DynamicResource EidolonText131}" />
                <TextBlock Text="{DynamicResource EidolonText132}" Classes="muted" FontSize="12" />
                <Button Classes="primary" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="{StaticResource EidolonIconDownload}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText133}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Content="{DynamicResource EidolonText134}" Command="{Binding UpdateAssetCommand}" HorizontalAlignment="Stretch" />
                <Button Content="{DynamicResource EidolonText135}" Command="{Binding RemoveAssetCommand}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{DynamicResource EidolonText136}" Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
</UserControl>
