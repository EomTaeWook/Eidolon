<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.PendingWorkView" x:DataType="vm:StudioSession" IsVisible="{Binding HasPendingRequests}">
  <DropDownButton x:Name="QueueButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="44" FontSize="13" CornerRadius="8" Padding="14,0" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="{Binding QueueSummary}">
    <Grid ColumnDefinitions="16,10,*">
      <Path Data="{StaticResource EidolonIconResults}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding QueueSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Grid>
    <DropDownButton.Flyout>
      <Flyout Placement="TopEdgeAlignedLeft" ShowMode="Standard" Opening="OnQueueFlyoutOpening">
        <Grid RowDefinitions="Auto,*,Auto" Width="640" MaxHeight="420">
          <TextBlock Text="{Binding QueueSummary}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1" Margin="0,12" Padding="0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="True">
              <ItemsControl ItemsSource="{Binding PendingRequests}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QueuedWorkItem">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Button Grid.Row="2" Content="{DynamicResource EidolonText246}" Command="{Binding ClearPendingCommand}" HorizontalAlignment="Right" Padding="12,6" />
        </Grid>
      </Flyout>
    </DropDownButton.Flyout>
  </DropDownButton>
</UserControl>
