<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.PendingWorkView" x:DataType="vm:StudioSession" IsVisible="{Binding HasPendingRequests}">
  <DropDownButton x:Name="QueueButton" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" Height="32" MinHeight="32" MaxWidth="460" FontSize="12" CornerRadius="6" Padding="10,0" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" ToolTip.Tip="{Binding QueueSummary}" AutomationProperties.Name="{Binding QueueSummary}">
    <Grid ColumnDefinitions="14,8,*">
      <Path Data="{StaticResource EidolonIconResults}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="{Binding QueueSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </Grid>
    <DropDownButton.Flyout>
      <Flyout Placement="TopEdgeAlignedLeft" ShowMode="Standard" Opening="OnQueueFlyoutOpening">
        <Grid RowDefinitions="Auto,*,Auto" Width="640" MaxHeight="420">
          <TextBlock Text="{Binding QueueSummary}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1" Margin="0,12" Padding="0,4">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="True">
              <ItemsControl ItemsSource="{Binding PendingRequests}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QueuedWorkItem">
                    <Border Background="{DynamicResource WindowBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                      <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Button Grid.Row="2" Content="{DynamicResource EidolonText246}" Command="{Binding ClearPendingCommand}" HorizontalAlignment="Right" MinHeight="32" FontSize="12" Padding="12,4" />
        </Grid>
      </Flyout>
    </DropDownButton.Flyout>
  </DropDownButton>
</UserControl>
