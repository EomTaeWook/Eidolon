<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.ModelDownloadsView" x:DataType="vm:AssetsViewModel">
    <ItemsControl ItemsSource="{Binding DownloadableModels}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ModelDownloadItem">
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10">
            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="10">
              <Border Width="28" Height="28" Background="{DynamicResource BadgeBrush}" CornerRadius="6" VerticalAlignment="Top" ToolTip.Tip="{Binding Model.FileName}">
                <Path Data="{StaticResource EidolonIconImage}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Text="{DynamicResource EidolonText348}" IsVisible="{Binding IsInstalled}" Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" />
              </StackPanel>
              <Panel Grid.Column="2" VerticalAlignment="Top">
                <Button Content="{Binding InstallCaption}" Command="{Binding InstallCommand}" Classes="primary" IsVisible="{Binding !IsInstalled}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,8" />
                <Button Content="{DynamicResource EidolonText355}" Command="{Binding DeleteCommand}" Classes="danger" IsVisible="{Binding IsInstalled}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="40" Padding="14,8" />
              </Panel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
