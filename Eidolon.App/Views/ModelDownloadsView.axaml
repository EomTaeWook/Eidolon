<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.ModelDownloadsView" x:DataType="vm:AssetsViewModel">
    <ItemsControl ItemsSource="{Binding DownloadableModels}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ModelDownloadItem">
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,12">
            <Grid ColumnDefinitions="40,*,Auto">
              <Border Width="32" Height="32" Background="{DynamicResource ButtonBrush}" CornerRadius="8" VerticalAlignment="Top" Margin="0,2,0,0">
                <Path Data="{StaticResource EidolonIconImage}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,16,0">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" />
                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" MinWidth="100">
                <Button Content="{Binding InstallCaption}" Command="{Binding InstallCommand}" Classes="primary" IsVisible="{Binding !IsInstalled}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,8" />
                <TextBlock Text="{DynamicResource EidolonText348}" IsVisible="{Binding IsInstalled}" Foreground="{DynamicResource AccentBrush}" FontSize="12" HorizontalAlignment="Center" />
                <Button Content="{DynamicResource EidolonText355}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsInstalled}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,8" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
