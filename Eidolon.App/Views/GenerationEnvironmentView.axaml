<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.GenerationEnvironmentView" x:DataType="vm:StudioViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Spacing="6" Margin="0,0,0,14">
      <TextBlock Text="{DynamicResource EidolonText581}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource EidolonText582}" Classes="muted" FontSize="13" />
    </StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding Navigation.SelectedEnvironmentTab, Mode=TwoWay}">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Padding" Value="18,10" />
        </Style>
      </TabControl.Styles>
      <TabItem Header="{DynamicResource EidolonText583}">
        <views:GenerationMethodView DataContext="{Binding Settings}" />
      </TabItem>
      <TabItem Header="{DynamicResource EidolonText107}">
        <views:ModelsView DataContext="{Binding Assets}" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>