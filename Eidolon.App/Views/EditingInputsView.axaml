<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.EditingInputsView" x:DataType="vm:GenerationViewModel" IsEnabled="{Binding Session.CanEditGenerationInputs}">
  <StackPanel Spacing="10">
    <TextBlock Text="{DynamicResource EidolonText457}" FontSize="15" FontWeight="SemiBold" />
    <TextBox Text="{Binding EditingPrompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="280" PlaceholderText="{DynamicResource EidolonText458}" />
    <views:ReferenceImageInputsView />
  </StackPanel>
</UserControl>
