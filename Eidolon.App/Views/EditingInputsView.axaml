<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.EditingInputsView" x:DataType="vm:GenerationViewModel" IsEnabled="{Binding Session.CanEditGenerationInputs}">
  <StackPanel Spacing="8">
    <TextBlock Text="{DynamicResource EidolonText457}" FontSize="14" FontWeight="SemiBold" />
    <TextBox Text="{Binding EditingPrompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="140" PlaceholderText="{DynamicResource EidolonText458}" />
    <TextBlock Text="{DynamicResource EidolonText459}" Classes="muted" FontSize="12" IsVisible="{Binding !HasReferenceImage}" />
  </StackPanel>
</UserControl>
