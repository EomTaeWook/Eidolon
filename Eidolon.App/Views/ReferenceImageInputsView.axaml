<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.ReferenceImageInputsView" x:DataType="vm:GenerationViewModel" IsEnabled="{Binding Session.CanEditGenerationInputs}">
  <UserControl.Styles>
    <Style Selector="Button.referenceAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.referenceAction:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="10">
    <TextBlock Text="{DynamicResource EidolonText440}" FontSize="13" FontWeight="SemiBold" />
    <StackPanel Spacing="10" IsVisible="{Binding !HasReferenceImage}">
      <Button Classes="referenceAction" Command="{Binding PickReferenceImageCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" Padding="12,10" FontSize="13" ToolTip.Tip="{Binding ReferenceImageHint}">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.5" VerticalAlignment="Center" />
          <TextBlock Text="{DynamicResource EidolonText441}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBlock Text="{DynamicResource EidolonText459}" Classes="muted" FontSize="12" IsVisible="{Binding Navigation.IsEditingView}" />
    </StackPanel>
    <StackPanel Spacing="10" IsVisible="{Binding HasReferenceImage}">
      <Grid ColumnDefinitions="64,10,*">
        <Border Width="64" Height="64" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ButtonBrush}">
          <Image Source="{Binding ReferenceThumbnail}" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding ReferenceImageName}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip.Tip="{Binding ReferenceImageName}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Content="{DynamicResource EidolonText442}" Command="{Binding PickReferenceImageCommand}" Padding="0,4" />
            <Button Classes="quiet" Content="{DynamicResource EidolonText443}" Command="{Binding ClearReferenceImageCommand}" Padding="0,4" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <TextBlock Text="{Binding ReferenceImageHint}" Classes="muted" FontSize="12" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource EidolonText448}" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding ReferenceStrengthCaption}" Classes="muted" FontSize="12" />
      </Grid>
      <Slider Minimum="0.05" Maximum="0.95" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding ReferenceChangeStrength, Mode=TwoWay}" />
      <TextBlock Text="{DynamicResource EidolonText449}" Classes="muted" FontSize="11" />
    </StackPanel>
  </StackPanel>
</UserControl>
