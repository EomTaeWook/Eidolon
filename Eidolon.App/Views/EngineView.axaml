<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.EngineView" x:DataType="vm:StudioViewModel">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ScrollViewer.engineContent /template/ ScrollBar#PART_VerticalScrollBar">
      <Setter Property="Width" Value="16" />
      <Setter Property="MinWidth" Value="16" />
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
    </Style>
    <Style Selector="ScrollViewer.engineContent /template/ ScrollBar#PART_VerticalScrollBar /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,0,4,14" Margin="0,0,0,16">
      <Grid ColumnDefinitions="Auto,28,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Path Data="{StaticResource EidolonIconEngine}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" />
          <TextBlock Text="{Binding EngineSetupCaption}" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Column="1" Width="1" Height="18" Background="{DynamicResource BorderBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Path Data="{StaticResource EidolonIconLibrary}" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" />
          <TextBlock Text="{Binding ModelSetupCaption}" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="3" Content="{Binding ModelSetupActionCaption}" Command="{Binding PrepareModelsCommand}" IsVisible="{Binding !NeedsModelSetup}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Padding="10,6" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" CornerRadius="6" Padding="16" Margin="0,0,0,16" IsVisible="{Binding NeedsModelSetup}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5" Margin="0,0,20,0">
          <TextBlock Text="{Binding ModelSetupCaption}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{Binding ModelSetupHint}" Classes="muted" FontSize="13" />
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding ModelSetupActionCaption}" Command="{Binding PrepareModelsCommand}" Classes="primary" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="2" Classes="engineContent" AllowAutoHide="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
      <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,16,Auto">
        <Border Classes="card" VerticalAlignment="Top">
          <StackPanel Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource EidolonText152}" Classes="sectionTitle" />
              <TextBlock Text="{DynamicResource EidolonText408}" Classes="muted" FontSize="13" />
            </StackPanel>
            <StackPanel Spacing="10" IsEnabled="{Binding CanInstallEngine}">
              <TextBlock Text="{DynamicResource EidolonText154}" FontSize="13" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding InstallDirectory, Mode=TwoWay}" PlaceholderText="{DynamicResource EidolonText155}" FontSize="13" Padding="10,9" />
                <Button Grid.Column="1" Content="{DynamicResource EidolonText142}" Command="{Binding PickInstallCommand}" Margin="8,0,0,0" />
              </Grid>
              <TextBlock Text="{DynamicResource EidolonText156}" Classes="muted" FontSize="12" />
              <CheckBox IsChecked="{Binding SettingsDraft.UseCpu}" Margin="0,2,0,4">
                <TextBlock Text="{DynamicResource EidolonText157}" FontSize="13" TextWrapping="Wrap" />
              </CheckBox>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding InstallCommand}" Classes.primary="{Binding !IsEngineConnected}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Data="{StaticResource EidolonIconDownload}" Width="15" Height="15" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText161}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Content="{DynamicResource EidolonText162}" Command="{Binding OpenRuntimeCommand}" />
              </StackPanel>
            </StackPanel>
            <Expander Header="{DynamicResource EidolonText416}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource EidolonText153}" Classes="muted" FontSize="12" />
                <TextBlock Text="{DynamicResource EidolonText158}" Classes="muted" FontSize="12" />
                <TextBlock Text="{DynamicResource EidolonText290}" Classes="muted" FontSize="12" />
                <TextBlock Text="{DynamicResource EidolonText163}" Classes="muted" FontSize="12" />
                <TextBlock Text="{DynamicResource EidolonText168}" Classes="muted" FontSize="12" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
          <StackPanel Spacing="18">
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource EidolonText164}" Classes="sectionTitle" />
              <TextBlock Text="{DynamicResource EidolonText264}" Classes="muted" FontSize="13" />
            </StackPanel>
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource EidolonText252}" FontSize="13" FontWeight="SemiBold" />
              <TextBox Text="{Binding ServerAddress, Mode=TwoWay}" PlaceholderText="http://127.0.0.1:8189" FontSize="13" Padding="10,9" />
              <Button Command="{Binding StartEngineCommand}" Classes="primary" IsVisible="{Binding !IsEngineConnected}" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Data="{StaticResource EidolonIconPlay}" Width="15" Height="15" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                  <TextBlock Text="{Binding StartEngineCaption}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Command="{Binding StopEngineCommand}" IsVisible="{Binding IsEngineConnected}" Margin="0,4,0,0">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Data="{StaticResource EidolonIconStop}" Width="15" Height="15" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                  <TextBlock Text="{Binding StopEngineCaption}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Expander Header="{DynamicResource EidolonText417}" HorizontalAlignment="Stretch">
              <TextBlock Text="{DynamicResource EidolonText253}" Classes="muted" FontSize="12" Margin="0,10,0,0" />
            </Expander>
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="card" Padding="16">
          <Expander Header="{DynamicResource EidolonText272}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="14" Margin="4,12,4,4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource EidolonText284}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                <Button Grid.Column="1" Content="{DynamicResource EidolonText273}" Command="{Binding RefreshRuntimeModulesCommand}" />
              </Grid>
              <TextBlock Text="{Binding RuntimeModulesError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" IsVisible="{Binding HasRuntimeModulesError}" />
              <Grid ColumnDefinitions="*,24,*">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText274}" Classes="label" />
                  <TextBlock Text="{DynamicResource EidolonText280}" Classes="muted" IsVisible="{Binding ShowRuntimeModulesEmpty}" />
                  <ItemsControl ItemsSource="{Binding RuntimeModules}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RuntimeModuleItem">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" IsVisible="{Binding HasVersion}" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding Location}" Classes="muted" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText275}" Classes="label" />
                  <TextBlock Text="{DynamicResource EidolonText281}" Classes="muted" IsVisible="{Binding ShowCustomNodesEmpty}" />
                  <ItemsControl ItemsSource="{Binding CustomNodes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RuntimeModuleItem">
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" IsVisible="{Binding HasVersion}" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding Location}" Classes="muted" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Expander>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
