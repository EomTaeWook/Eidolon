<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="using:Avalonia.Data.Converters" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.EngineView" x:DataType="vm:EngineViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ScrollViewer.engineToolBody">
      <Setter Property="Padding" Value="0,0,16,0" />
    </Style>
    <Style Selector="ScrollViewer.engineToolBody /template/ ScrollContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" Margin="16,0,16,0">
    <Grid.ColumnDefinitions>
      <!-- 700 for the content and 16 reserved for the vertical scrollbar. -->
      <ColumnDefinition Width="*" MaxWidth="716" />
    </Grid.ColumnDefinitions>
    <StackPanel Margin="0,16,16,8" Spacing="4" IsEnabled="{Binding CanEditInstallDirectory}">
      <TextBlock Text="{DynamicResource EidolonText154}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding Settings.InstallDirectory, Mode=TwoWay}" PlaceholderText="{DynamicResource EidolonText155}" Classes="folderPath" />
        <Button Grid.Column="1" Content="{DynamicResource EidolonText142}" Command="{Binding Settings.PickInstallCommand}" Classes="folderAction" />
      </Grid>
    </StackPanel>
    <TabControl Grid.Row="1" Padding="0" SelectedIndex="{Binding Navigation.SelectedEngineToolTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>
      <TabItem Header="ComfyUI">
        <ScrollViewer Classes="engineToolBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          <StackPanel Margin="0,8,0,16" Spacing="8">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource EidolonText152}" Classes="sectionTitle" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <Path Data="{StaticResource EidolonIconEngine}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" />
                  <TextBlock Grid.Column="1" Text="{Binding Assets.EngineSetupCaption}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <Button Grid.Column="1" Command="{Binding InstallCommand}" Classes.primary="{Binding !IsEngineConnected}" IsVisible="{Binding CanInstallEngine}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{StaticResource EidolonIconDownload}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                  <TextBlock Text="{DynamicResource EidolonText161}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="{DynamicResource EidolonText408}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8" LineSpacing="4" IsEnabled="{Binding CanInstallEngine}">
              <CheckBox IsChecked="{Binding Session.SettingsDraft.UseCpu}">
                <TextBlock Text="{DynamicResource EidolonText157}" TextWrapping="Wrap" />
              </CheckBox>
              <Button Content="{DynamicResource EidolonText162}" Command="{Binding OpenRuntimeCommand}" Classes="folderAction" IsVisible="{ReflectionBinding $self.IsEffectivelyEnabled}" />
            </WrapPanel>
            <Expander Header="{DynamicResource EidolonText416}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource EidolonText156}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText153}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText158}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText290}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText163}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText168}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4" />
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource EidolonText164}" Classes="sectionTitle" TextWrapping="Wrap" />
                <TextBlock Text="{Binding EngineStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <Panel Grid.Column="1" VerticalAlignment="Center">
                <Button Command="{Binding StartEngineCommand}" Classes="primary" IsVisible="{Binding !IsEngineConnected}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource EidolonIconPlay}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{Binding StartEngineCaption}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Command="{Binding StopEngineCommand}" IsVisible="{Binding IsEngineConnected}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource EidolonIconStop}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{Binding StopEngineCaption}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Panel>
            </Grid>
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource EidolonText252}" />
              <TextBox Text="{Binding Settings.ServerAddress, Mode=TwoWay}" PlaceholderText="http://127.0.0.1:8189" />
              <TextBlock Text="{DynamicResource EidolonText264}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <Expander Header="{DynamicResource EidolonText417}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <TextBlock Text="{DynamicResource EidolonText253}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Expander>
          </StackPanel>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Path Data="{StaticResource EidolonIconLibrary}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" />
                <TextBlock Grid.Column="1" Text="{Binding Assets.ModelSetupCaption}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="{Binding Assets.ModelSetupHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Assets.NeedsModelSetup}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" Classes.primary="{Binding Assets.NeedsModelSetup}" VerticalAlignment="Center" />
          </Grid>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4" />
          <Expander Header="{DynamicResource EidolonText272}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <Button Content="{DynamicResource EidolonText273}" Command="{Binding RefreshRuntimeModulesCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="{DynamicResource EidolonText284}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding RuntimeModulesError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" IsVisible="{Binding HasRuntimeModulesError}" />
              <TextBlock Text="{DynamicResource EidolonText274}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource EidolonText280}" Classes="muted" FontSize="12" IsVisible="{Binding ShowRuntimeModulesEmpty}" />
              <ItemsControl ItemsSource="{Binding RuntimeModules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuntimeModuleItem">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" IsVisible="{Binding HasVersion}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Location}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" IsVisible="{Binding Location, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource EidolonText275}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource EidolonText281}" Classes="muted" FontSize="12" IsVisible="{Binding ShowCustomNodesEmpty}" />
              <ItemsControl ItemsSource="{Binding CustomNodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuntimeModuleItem">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" IsVisible="{Binding HasVersion}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Location}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" IsVisible="{Binding Location, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4" IsVisible="{Binding CanOpenTrainingData}" />
          <StackPanel Spacing="8" IsVisible="{Binding CanOpenTrainingData}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{DynamicResource EidolonText575}" Classes="sectionTitle" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="{DynamicResource EidolonText332}" Command="{Binding OpenTrainingDataCommand}" Classes="folderAction" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{DynamicResource EidolonText576}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding TrainingDataDirectory}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding TrainingDataDirectory, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
            <Button Content="{DynamicResource EidolonText577}" Command="{Binding ClearTrainingDataCommand}" Classes="danger" HorizontalAlignment="Left" />
          </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Blender">
        <ScrollViewer Classes="engineToolBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          <StackPanel Margin="0,8,0,16" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding BlenderStatus}" Classes="muted" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Panel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="{DynamicResource EidolonText741}" Command="{Binding InstallBlenderCommand}" Classes="primary" IsVisible="{Binding CanInstallBlender}" />
                <Panel IsVisible="{Binding BlenderExecutablePath, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                  <Button Content="{DynamicResource EidolonText162}" Command="{Binding OpenBlenderDirectoryCommand}" Classes="folderAction" IsVisible="{ReflectionBinding $self.IsEffectivelyEnabled}" />
                </Panel>
              </Panel>
            </Grid>
            <Expander Header="{DynamicResource EidolonText416}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="{Binding BlenderVersion}" Classes="muted" FontSize="12" IsVisible="{Binding BlenderVersion, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{DynamicResource EidolonText742}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding BlenderInstallDirectory, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{DynamicResource EidolonText767}" Classes="muted" FontSize="12" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding BlenderInstallDirectory}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding BlenderExecutablePath, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{DynamicResource EidolonText768}" Classes="muted" FontSize="12" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding BlenderExecutablePath}" FontSize="12" TextWrapping="Wrap" />
                </Grid>
                <Panel IsVisible="{Binding BlenderExecutablePath, Converter={x:Static converters:StringConverters.IsNullOrEmpty}}">
                  <Button Content="{DynamicResource EidolonText162}" Command="{Binding OpenBlenderDirectoryCommand}" Classes="folderAction" HorizontalAlignment="Left" IsVisible="{ReflectionBinding $self.IsEffectivelyEnabled}" />
                </Panel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource EidolonText712}">
        <ScrollViewer Classes="engineToolBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          <StackPanel Margin="0,8,0,16" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding PromptConverterStatus}" Classes="muted" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Panel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="{DynamicResource EidolonText715}" Command="{Binding InstallPromptConverterCommand}" Classes="primary">
                  <Button.IsVisible>
                    <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                      <Binding Path="!IsPromptConverterInstalled" />
                      <Binding Path="CanInstallPromptConverter" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>
                <Button Content="{DynamicResource EidolonText718}" Command="{Binding DeletePromptConverterCommand}" Classes="danger">
                  <Button.IsVisible>
                    <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                      <Binding Path="IsPromptConverterInstalled" />
                      <Binding Path="CanDeletePromptConverter" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>
              </Panel>
            </Grid>
            <Expander Header="{DynamicResource EidolonText416}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource EidolonText714}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText713}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText716}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Spacing="4" IsVisible="{Binding PromptConverterInstallDirectory, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{DynamicResource EidolonText154}" Classes="muted" FontSize="12" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding PromptConverterInstallDirectory}" FontSize="12" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="{DynamicResource EidolonText717}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="{DynamicResource EidolonText718}" Command="{Binding DeletePromptConverterCommand}" Classes="danger" HorizontalAlignment="Left">
                  <Button.IsVisible>
                    <MultiBinding Converter="{x:Static converters:BoolConverters.And}">
                      <Binding Path="!IsPromptConverterInstalled" />
                      <Binding Path="CanDeletePromptConverter" />
                    </MultiBinding>
                  </Button.IsVisible>
                </Button>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
