<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:converters="using:Avalonia.Data.Converters" x:Class="Eidolon.App.Views.EngineView" x:DataType="vm:EngineViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="8">
    <StackPanel Spacing="8" IsEnabled="{Binding CanEditInstallDirectory}">
      <TextBlock Text="{DynamicResource EidolonText154}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Text="{Binding Settings.InstallDirectory, Mode=TwoWay}" PlaceholderText="{DynamicResource EidolonText155}" />
        <Button Grid.Column="1" Content="{DynamicResource EidolonText142}" Command="{Binding Settings.PickInstallCommand}" />
      </Grid>
    </StackPanel>
    <TabControl SelectedIndex="{Binding Navigation.SelectedEngineToolTab, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
      <TabItem Header="ComfyUI">
        <StackPanel Spacing="8">
          <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0">
                  <Path Data="{StaticResource EidolonIconEngine}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" />
                  <TextBlock Text="{Binding Assets.EngineSetupCaption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{StaticResource EidolonIconLibrary}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" />
                  <TextBlock Text="{Binding Assets.ModelSetupCaption}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </WrapPanel>
              <Button Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" IsVisible="{Binding !Assets.NeedsModelSetup}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding Assets.NeedsModelSetup}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Assets.ModelSetupCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Assets.ModelSetupHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <Button Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" Classes="primary" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource EidolonText152}" Classes="sectionTitle" />
            <TextBlock Text="{DynamicResource EidolonText408}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Spacing="8" IsEnabled="{Binding CanInstallEngine}">
              <TextBlock Text="{DynamicResource EidolonText156}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <CheckBox IsChecked="{Binding Session.SettingsDraft.UseCpu}">
                <TextBlock Text="{DynamicResource EidolonText157}" TextWrapping="Wrap" />
              </CheckBox>
              <WrapPanel>
                <Button Command="{Binding InstallCommand}" Classes.primary="{Binding !IsEngineConnected}" Margin="0,0,8,8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource EidolonIconDownload}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText161}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Content="{DynamicResource EidolonText162}" Command="{Binding OpenRuntimeCommand}" Margin="0,0,0,8" />
              </WrapPanel>
            </StackPanel>
            <Expander Header="{DynamicResource EidolonText416}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource EidolonText153}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText158}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText290}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText163}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText168}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>
          </StackPanel>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />
          <StackPanel Spacing="8">
            <TextBlock Text="{DynamicResource EidolonText164}" Classes="sectionTitle" />
            <TextBlock Text="{DynamicResource EidolonText264}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource EidolonText252}" />
            <TextBox Text="{Binding Settings.ServerAddress, Mode=TwoWay}" PlaceholderText="http://127.0.0.1:8189" />
            <Button Command="{Binding StartEngineCommand}" Classes="primary" IsVisible="{Binding !IsEngineConnected}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource EidolonIconPlay}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                <TextBlock Text="{Binding StartEngineCaption}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Command="{Binding StopEngineCommand}" IsVisible="{Binding IsEngineConnected}" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="{StaticResource EidolonIconStop}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                <TextBlock Text="{Binding StopEngineCaption}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Expander Header="{DynamicResource EidolonText417}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <TextBlock Text="{DynamicResource EidolonText253}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Expander>
          </StackPanel>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />
          <Expander Header="{DynamicResource EidolonText272}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBlock Text="{DynamicResource EidolonText284}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <Button Content="{DynamicResource EidolonText273}" Command="{Binding RefreshRuntimeModulesCommand}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding RuntimeModulesError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextBrush}" IsVisible="{Binding HasRuntimeModulesError}" />
              <TextBlock Text="{DynamicResource EidolonText274}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource EidolonText280}" Classes="muted" FontSize="12" IsVisible="{Binding ShowRuntimeModulesEmpty}" />
              <ItemsControl ItemsSource="{Binding RuntimeModules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuntimeModuleItem">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" IsVisible="{Binding HasVersion}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Location}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource EidolonText275}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource EidolonText281}" Classes="muted" FontSize="12" IsVisible="{Binding ShowCustomNodesEmpty}" />
              <ItemsControl ItemsSource="{Binding CustomNodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuntimeModuleItem">
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Version}" Classes="muted" FontSize="12" IsVisible="{Binding HasVersion}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Location}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Expander>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" IsVisible="{Binding CanOpenTrainingData}" />
          <StackPanel Spacing="8" IsVisible="{Binding CanOpenTrainingData}">
            <TextBlock Text="{DynamicResource EidolonText575}" Classes="sectionTitle" />
            <TextBlock Text="{DynamicResource EidolonText576}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <SelectableTextBlock Text="{Binding TrainingDataDirectory}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="{DynamicResource EidolonText332}" Command="{Binding OpenTrainingDataCommand}" Margin="0,0,8,0" />
              <Button Content="{DynamicResource EidolonText577}" Command="{Binding ClearTrainingDataCommand}" Classes="danger" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="Blender">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding BlenderStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Panel Grid.Column="1" VerticalAlignment="Center">
              <Button Content="{DynamicResource EidolonText741}" Command="{Binding InstallBlenderCommand}" Classes="primary" IsVisible="{Binding CanInstallBlender}" />
              <Button Content="{DynamicResource EidolonText162}" Command="{Binding OpenBlenderDirectoryCommand}" Classes="folderAction" IsVisible="{Binding BlenderExecutablePath, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" />
            </Panel>
          </Grid>
          <Expander Header="{DynamicResource EidolonText416}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBlock Text="{Binding BlenderVersion}" Classes="muted" FontSize="12" />
              <TextBlock Text="{DynamicResource EidolonText742}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding BlenderInstallDirectory, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{DynamicResource EidolonText767}" Classes="muted" FontSize="12" />
                <SelectableTextBlock Text="{Binding BlenderInstallDirectory}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel IsVisible="{Binding BlenderExecutablePath, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{DynamicResource EidolonText768}" Classes="muted" FontSize="12" />
                <SelectableTextBlock Text="{Binding BlenderExecutablePath}" TextWrapping="Wrap" />
              </StackPanel>
              <Panel IsVisible="{Binding BlenderExecutablePath, Converter={x:Static converters:StringConverters.IsNullOrEmpty}}">
                <Button Content="{DynamicResource EidolonText162}" Command="{Binding OpenBlenderDirectoryCommand}" Classes="folderAction" HorizontalAlignment="Left" IsVisible="{ReflectionBinding $self.IsEffectivelyEnabled}" />
              </Panel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </TabItem>
      <TabItem Header="{DynamicResource EidolonText712}">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource EidolonText712}" Classes="sectionTitle" />
          <TextBlock Text="{DynamicResource EidolonText713}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{DynamicResource EidolonText714}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PromptConverterStatus}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="{DynamicResource EidolonText154}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SelectableTextBlock Text="{Binding PromptConverterInstallDirectory}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{DynamicResource EidolonText142}" Command="{Binding Settings.PickInstallCommand}" />
          </Grid>
          <TextBlock Text="{DynamicResource EidolonText717}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="{DynamicResource EidolonText715}" Command="{Binding InstallPromptConverterCommand}" Classes="primary" Margin="0,0,8,8" />
            <Button Content="{DynamicResource EidolonText718}" Command="{Binding DeletePromptConverterCommand}" Classes="danger" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBlock Text="{DynamicResource EidolonText716}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>