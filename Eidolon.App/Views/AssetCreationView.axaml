<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.AssetCreationView" x:DataType="vm:AssetCreationViewModel">
  <Grid RowDefinitions="Auto,12,*,12,Auto" ColumnDefinitions="*,16,320">
    <StackPanel Spacing="6" Grid.ColumnSpan="3">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource EidolonText603}" Classes="title" />
        <Border Grid.Column="1" Background="{DynamicResource BadgeBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Session.CodexModelCaption}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.CodexModelCaption}" />
        </Border>
      </Grid>
      <TextBlock Text="{DynamicResource EidolonText604}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource EidolonText655}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="8">
      <Border Classes="card" Padding="12">
        <Grid RowDefinitions="*,Auto">
          <Grid ClipToBounds="True">
            <Panel IsVisible="{Binding !Preview.HasCollection}">
              <Grid IsVisible="{Binding HasReference}">
                <views:TransparencyBackground />
                <Image Source="{Binding ReferenceThumbnail}" Stretch="Uniform" ToolTip.Tip="{Binding ReferenceName}" />
              </Grid>
              <Button Command="{Binding PickReferenceCommand}" Classes="primary" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="40" IsVisible="{Binding !HasReference}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.5" />
                  <TextBlock Text="{DynamicResource EidolonText792}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Panel>
            <Panel IsVisible="{Binding Preview.HasCollection}">
              <Grid IsVisible="{Binding Preview.HasSelectedImage}">
                <views:TransparencyBackground />
                <views:AssetPreviewImage Source="{Binding Preview.Preview}" Stretch="Uniform" Interpolation="{Binding Preview.Interpolation}" />
              </Grid>
              <TextBlock Text="{Binding Preview.SelectedFrame.StateCaption}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Preview.HasSelectedImage}" />
            </Panel>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding Preview.HasCollection}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding Preview.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Preview.Title}" />
              <TextBlock Grid.Column="1" Text="{Binding CollectionStateCaption}" Classes="muted" FontSize="12" />
            </Grid>
            <ListBox ItemsSource="{Binding Preview.Frames}" SelectedItem="{Binding Preview.SelectedFrame, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="4" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AssetFrameItem">
                  <StackPanel Spacing="4">
                    <Border Height="52" CornerRadius="5" ClipToBounds="True">
                      <Grid>
                        <views:TransparencyBackground />
                        <views:AssetPreviewImage Source="{Binding Image}" Stretch="Uniform" Interpolation="{ReflectionBinding $parent[UserControl].DataContext.Preview.Interpolation}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Caption}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Caption}" />
                    <TextBlock Text="{Binding StateCaption}" Classes="muted" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ErrorCaption}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>
      <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="6" IsVisible="{Binding Preview.HasCollection}">
        <Button Content="{DynamicResource EidolonText630}" Command="{Binding RegenerateCommand}" />
        <Button Content="{DynamicResource EidolonText649}" Command="{Binding Preview.ExportCommand}" Classes="primary" ToolTip.Tip="{DynamicResource EidolonText648}" />
        <Button Content="{DynamicResource EidolonText632}" Command="{Binding ReplaceCommand}" />
        <Button Content="{DynamicResource EidolonText633}" Command="{Binding ResumeCommand}" IsVisible="{ReflectionBinding $self.IsEffectivelyEnabled}" />
        <Button Content="{DynamicResource EidolonText332}" Command="{Binding Preview.OpenExportCommand}" IsVisible="{Binding Preview.HasExport}" />
      </WrapPanel>
    </Grid>
    <Border Classes="card" Padding="16" Grid.Row="2" Grid.RowSpan="3" Grid.Column="2">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" IsEnabled="{Binding Session.CanEditGenerationInputs}" Margin="0,0,20,0">
          <StackPanel Spacing="6" IsVisible="{Binding HasReference}">
            <TextBlock Text="{DynamicResource EidolonText608}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ReferenceName}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip.Tip="{Binding ReferenceName}" />
            <Button Content="{DynamicResource EidolonText442}" Command="{Binding PickReferenceCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <Panel IsVisible="{Binding Preview.HasCollection}">
            <Button Content="{DynamicResource EidolonText792}" Command="{Binding PickReferenceCommand}" IsVisible="{Binding !HasReference}" HorizontalAlignment="Left" />
          </Panel>
          <TextBlock Text="{DynamicResource EidolonText606}" FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
          <StackPanel Spacing="8">
            <Border Height="1" Background="{DynamicResource BorderBrush}" />
            <ToggleButton x:Name="OptionsToggle" Classes="disclosure" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource EidolonText645}" FontSize="12" VerticalAlignment="Center" />
                <Path Grid.Column="1" Data="M 2 4 L 7 9 L 12 4" Width="12" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Margin="12,0,0,0" />
              </Grid>
            </ToggleButton>
            <StackPanel Spacing="10" IsVisible="{Binding #OptionsToggle.IsChecked}">
              <CheckBox Content="{DynamicResource EidolonText308}" IsChecked="{Binding RemoveBackground, Mode=TwoWay}" FontSize="12" />
              <CheckBox Content="{DynamicResource EidolonText614}" IsChecked="{Binding PixelArt, Mode=TwoWay}" FontSize="12" />
              <TextBlock Text="{DynamicResource EidolonText615}" FontSize="12" />
              <NumericUpDown Value="{Binding FrameSize, Mode=TwoWay}" Minimum="16" Maximum="2048" FormatString="0" />
              <TextBlock Text="{DynamicResource EidolonText616}" FontSize="12" />
              <NumericUpDown Value="{Binding Columns, Mode=TwoWay}" Minimum="1" Maximum="4" FormatString="0" />
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{DynamicResource EidolonText629}" Classes="muted" FontSize="12" />
          <StackPanel Spacing="6" IsVisible="{Binding Preview.HasCollection}">
            <Border Height="1" Background="{DynamicResource BorderBrush}" />
            <TextBlock Text="{Binding Preview.SelectedFrame.Caption}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Preview.SeedCaption}" Classes="muted" FontSize="12" IsVisible="{Binding Preview.HasSeed}" />
            <StackPanel Spacing="4" IsEnabled="{Binding Preview.CanEditSelection}">
              <TextBlock Text="{DynamicResource EidolonText628}" FontSize="12" />
              <TextBox Text="{Binding Preview.SelectedFrame.Prompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="130" />
            </StackPanel>
            <Button Content="{DynamicResource EidolonText656}" Command="{Binding DeleteCollectionCommand}" Classes="danger" HorizontalAlignment="Left" />
          </StackPanel>
          <Expander Header="{DynamicResource EidolonText623}" IsExpanded="False" IsVisible="{Binding HasResumeCollections}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding Collections}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AssetCollectionChoice">
                  <Button Command="{ReflectionBinding $parent[UserControl].DataContext.OpenResumeCollectionCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,4">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Caption}" />
                      <TextBlock Text="{Binding StateCaption}" Classes="muted" FontSize="12" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12" Classes="card" CornerRadius="12">
      <StackPanel Spacing="8">
        <StackPanel Spacing="8" IsEnabled="{Binding Session.CanEditGenerationInputs}">
          <TextBlock Text="{DynamicResource EidolonText112}" Classes="label" />
          <TextBox Text="{Binding Prompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="{DynamicResource EidolonText641}" Height="80" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <Button Content="{DynamicResource EidolonText631}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{DynamicResource EidolonText617}" Command="{Binding CreateCommand}" Classes="primary" MinHeight="40" />
        </Grid>
        <views:PendingWorkView DataContext="{Binding Session}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
