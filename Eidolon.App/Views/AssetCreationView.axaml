<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.AssetCreationView" x:DataType="vm:AssetCreationViewModel">
  <UserControl.Styles>
    <Style Selector="Button.assetLora">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,10" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Button.assetLora.active">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.assetLora.active:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.assetLora.active:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.assetLora:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.assetLora.active:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,24,*">
    <StackPanel Spacing="5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource EidolonText603}" Classes="title" />
        <Border Grid.Column="1" Background="{DynamicResource BadgeBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Session.GenerationBackendCaption}" FontSize="12" />
        </Border>
      </Grid>
      <TextBlock Text="{DynamicResource EidolonText604}" Classes="muted" FontSize="12" />
      <TextBlock Text="{DynamicResource EidolonText655}" Classes="muted" FontSize="12" IsVisible="{Binding !IsComfyAssetCreation}" />
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="300,20,*">
      <Border Classes="card" Padding="0">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Margin="22,22,10,0" Padding="0,0,12,16" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" IsEnabled="{Binding Session.CanEditGenerationInputs}">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText608}" FontWeight="SemiBold" />
                <Button Command="{Binding PickReferenceCommand}" HorizontalAlignment="Stretch" MinHeight="92" HorizontalContentAlignment="Center">
                  <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Path Data="{StaticResource EidolonIconImage}" Width="24" Height="24" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.5" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource EidolonText441}" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Grid ColumnDefinitions="64,12,*" IsVisible="{Binding HasReference}">
                  <Border CornerRadius="5" ClipToBounds="True">
                    <Grid>
                      <views:TransparencyBackground />
                      <Image Source="{Binding ReferenceThumbnail}" Width="64" Height="64" Stretch="Uniform" />
                    </Grid>
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding ReferenceName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                </Grid>
              </StackPanel>
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText609}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource EidolonText606}" FontSize="13" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                <TextBox Text="{Binding Prompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="240" PlaceholderText="{DynamicResource EidolonText641}" />
              </StackPanel>
              <StackPanel Spacing="8">
                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <StackPanel Spacing="8" IsVisible="{Binding IsComfyAssetCreation}">
                  <TextBlock Text="{Binding Assets.SelectedModel.Label}" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12" IsVisible="{Binding Assets.HasAvailableModels}" />
                  <StackPanel Spacing="8" IsVisible="{Binding !Assets.HasAvailableModels}">
                    <TextBlock Text="{Binding Assets.ModelSetupCaption}" Classes="muted" FontSize="12" />
                    <Button Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </StackPanel>
                <ToggleButton x:Name="OptionsToggle" Classes="disclosure" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource EidolonText645}" FontSize="12" VerticalAlignment="Center" />
                    <Path Grid.Column="1" Data="M 2 4 L 7 9 L 12 4" Width="12" Height="8" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" Margin="12,0,0,0" />
                  </Grid>
                </ToggleButton>
                <StackPanel Spacing="10" IsVisible="{Binding #OptionsToggle.IsChecked}">
                  <StackPanel Spacing="10" IsVisible="{Binding IsComfyAssetCreation}">
                    <TextBlock Text="{DynamicResource EidolonText359}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Assets.Models}" SelectedItem="{Binding Assets.SelectedModel, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AssetItem">
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource EidolonText423}" FontSize="12" />
                    <TextBox Text="{Binding Assets.LoraSearch, Mode=TwoWay}" PlaceholderText="{DynamicResource EidolonText432}" IsVisible="{Binding Assets.ShowLoraSearch}" FontSize="12" />
                    <ScrollViewer MaxHeight="112" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl ItemsSource="{Binding Assets.FilteredLoras}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AssetItem">
                            <Button Classes="assetLora" Classes.active="{Binding IsSelected}" Click="OnLoraClicked" ToolTip.Tip="{Binding TriggerCaption}">
                              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{DynamicResource EidolonText613}" FontSize="12" />
                    <Slider Value="{Binding ChangeStrength, Mode=TwoWay}" Minimum="0.05" Maximum="0.95" />
                  </StackPanel>
                  <CheckBox Content="{DynamicResource EidolonText308}" IsChecked="{Binding RemoveBackground, Mode=TwoWay}" FontSize="12" />
                  <CheckBox Content="{DynamicResource EidolonText614}" IsChecked="{Binding PixelArt, Mode=TwoWay}" FontSize="12" />
                  <TextBlock Text="{DynamicResource EidolonText615}" FontSize="12" />
                  <NumericUpDown Value="{Binding FrameSize, Mode=TwoWay}" Minimum="16" Maximum="2048" FormatString="0" />
                  <TextBlock Text="{DynamicResource EidolonText616}" FontSize="12" />
                  <NumericUpDown Value="{Binding Columns, Mode=TwoWay}" Minimum="1" Maximum="5" FormatString="0" />
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{DynamicResource EidolonText629}" Classes="muted" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,18">
            <StackPanel Spacing="8">
              <Button Content="{DynamicResource EidolonText617}" Command="{Binding CreateCommand}" Classes="primary" HorizontalAlignment="Stretch" MinHeight="44" />
              <Button Content="{DynamicResource EidolonText631}" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" HorizontalAlignment="Stretch" />
              <views:PendingWorkView DataContext="{Binding Session}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="2" RowDefinitions="Auto,16,*,16,Auto">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <ComboBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection, Mode=TwoWay}" PlaceholderText="{DynamicResource EidolonText623}" IsEnabled="{Binding Session.CanQueue}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AssetCollectionChoice">
                <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Grid.Column="1" Content="{DynamicResource EidolonText656}" Command="{Binding DeleteCollectionCommand}" Margin="8,0,0,0" />
          <Button Grid.Column="2" Content="{DynamicResource EidolonText410}" Command="{Binding RefreshCollectionsCommand}" Margin="8,0,0,0" />
        </Grid>
        <Border Grid.Row="2" Classes="card" Padding="24">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <TextBlock Text="{DynamicResource EidolonText622}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Preview.Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Preview.SeedCaption}" Classes="muted" FontSize="12" IsVisible="{Binding Preview.HasSeed}" />
              <TextBlock Text="{Binding Preview.SelectedFrame.Caption}" FontWeight="SemiBold" FontSize="13" IsVisible="{Binding Preview.HasFrames}" />
              <Border Height="300" CornerRadius="12" ClipToBounds="True" IsVisible="{Binding Preview.HasFrames}">
                <Grid>
                  <views:TransparencyBackground />
                  <views:AssetPreviewImage Source="{Binding Preview.Preview}" Stretch="Uniform" Interpolation="{Binding Preview.Interpolation}" />
                </Grid>
              </Border>
              <ListBox ItemsSource="{Binding Preview.Frames}" SelectedItem="{Binding Preview.SelectedFrame, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" MaxHeight="{Binding Preview.FrameListHeight}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssetFrameItem">
                    <StackPanel Width="{ReflectionBinding $parent[UserControl].DataContext.Preview.ThumbnailWidth}" Spacing="6" Margin="4">
                      <Border CornerRadius="5" ClipToBounds="True">
                        <Grid>
                          <views:TransparencyBackground />
                          <views:AssetPreviewImage Source="{Binding Image}" Height="{ReflectionBinding $parent[UserControl].DataContext.Preview.ThumbnailHeight}" Stretch="Uniform" Interpolation="{ReflectionBinding $parent[UserControl].DataContext.Preview.Interpolation}" />
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding Caption}" FontSize="12" />
                      <TextBlock Text="{Binding StateCaption}" Classes="muted" FontSize="11" ToolTip.Tip="{Binding ErrorCaption}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Spacing="8" IsVisible="{Binding Preview.HasCollection}" IsEnabled="{Binding Preview.CanEditSelection}">
                <TextBlock Text="{DynamicResource EidolonText628}" FontSize="12" />
                <TextBox Text="{Binding Preview.SelectedFrame.Prompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="130" />
                <WrapPanel>
                  <Button Content="{DynamicResource EidolonText630}" Command="{Binding RegenerateCommand}" Margin="0,0,8,8" />
                  <Button Content="{DynamicResource EidolonText632}" Command="{Binding ReplaceCommand}" Margin="0,0,8,8" />
                  <Button Content="{DynamicResource EidolonText633}" Command="{Binding ResumeCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4" Spacing="8">
          <TextBlock Text="{DynamicResource EidolonText648}" Classes="muted" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{DynamicResource EidolonText649}" Command="{Binding Preview.ExportCommand}" Classes="primary" />
            <Button Content="{DynamicResource EidolonText332}" Command="{Binding Preview.OpenExportCommand}" IsVisible="{Binding Preview.HasExport}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
