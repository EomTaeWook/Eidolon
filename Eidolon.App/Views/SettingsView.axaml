<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.SettingsView" x:DataType="vm:StudioViewModel">
  <Grid RowDefinitions="Auto,*">
    <StackPanel Spacing="6" Margin="0,0,0,14">
      <TextBlock Text="{DynamicResource EidolonText110}" FontSize="24" FontWeight="SemiBold" />
    </StackPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding Navigation.SelectedSettingsTab, Mode=TwoWay}">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Padding" Value="18,10" />
        </Style>
      </TabControl.Styles>
      <TabItem Header="{DynamicResource EidolonText594}">
        <views:GeneralSettingsView />
      </TabItem>
      <TabItem Header="{DynamicResource EidolonText593}">
        <views:EngineView DataContext="{Binding Engine}" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>