<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.SettingsView" x:DataType="vm:StudioViewModel" Background="{DynamicResource WindowBrush}">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.folderAction">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox.folderPath">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
      <TextBlock Text="{DynamicResource EidolonText110}" FontSize="16" FontWeight="SemiBold" />
    </Border>
    <TabControl Grid.Row="1" SelectedIndex="{Binding Navigation.SelectedSettingsTab, Mode=TwoWay}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <TabItem Header="{DynamicResource EidolonText594}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          <views:GeneralSettingsView Margin="16" MaxWidth="700" HorizontalAlignment="Left" />
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource EidolonText109}">
        <views:EngineView DataContext="{Binding Engine}" />
      </TabItem>
      <TabItem Header="{DynamicResource EidolonText595}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          <StackPanel Margin="16" Spacing="8" MaxWidth="700" HorizontalAlignment="Left" DataContext="{Binding Mcp}" x:DataType="vm:McpViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding StatusCaption}" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Panel Grid.Column="1" VerticalAlignment="Center">
                <Button Content="{DynamicResource EidolonText600}" Command="{Binding StartCommand}" Classes="primary" IsVisible="{Binding !IsRunning}" />
                <Button Content="{DynamicResource EidolonText601}" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" />
              </Panel>
            </Grid>
            <TextBox Text="{Binding Endpoint, Mode=OneWay}" IsReadOnly="True" Classes="folderPath" ToolTip.Tip="{Binding Endpoint}" />
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource EidolonText596}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource EidolonText597}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource EidolonText666}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          <views:AppUpdateView DataContext="{Binding Updates}" Margin="16" MaxWidth="700" HorizontalAlignment="Left">
            <views:AppUpdateView.Styles>
              <Style Selector="TextBlock[FontSize=16][FontWeight=SemiBold]">
                <Setter Property="IsVisible" Value="False" />
              </Style>
            </views:AppUpdateView.Styles>
          </views:AppUpdateView>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
