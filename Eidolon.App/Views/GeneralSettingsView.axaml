<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.GeneralSettingsView" x:DataType="vm:StudioViewModel">
  <StackPanel Spacing="8">
    <StackPanel Spacing="8">
      <TextBlock Text="{DynamicResource EidolonText172}" FontSize="16" FontWeight="SemiBold" />
      <WrapPanel>
        <RadioButton GroupName="EidolonLanguage" Content="{DynamicResource EidolonText222}" IsChecked="{Binding Settings.IsKoreanLanguage, Mode=TwoWay}" Margin="0,0,8,0" />
        <RadioButton GroupName="EidolonLanguage" Content="English" IsChecked="{Binding Settings.IsEnglishLanguage, Mode=TwoWay}" />
      </WrapPanel>
    </StackPanel>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />
    <StackPanel Spacing="8">
      <TextBlock Text="{DynamicResource EidolonText170}" FontSize="16" FontWeight="SemiBold" />
      <WrapPanel>
        <RadioButton GroupName="EidolonTheme" Content="{DynamicResource EidolonText220}" IsChecked="{Binding Settings.IsLightTheme, Mode=TwoWay}" Margin="0,0,8,0" />
        <RadioButton GroupName="EidolonTheme" Content="{DynamicResource EidolonText221}" IsChecked="{Binding Settings.IsBlackTheme, Mode=TwoWay}" />
      </WrapPanel>
    </StackPanel>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" />
    <StackPanel Spacing="8">
      <TextBlock Text="{DynamicResource EidolonText546}" FontSize="16" FontWeight="SemiBold" />
      <TextBlock Text="{DynamicResource EidolonText297}" FontSize="14" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox Classes="folderPath" Text="{Binding Settings.GenerationDirectory, Mode=TwoWay}" ToolTip.Tip="{Binding Settings.GenerationDirectory}" />
        <Button Grid.Column="1" Classes="folderAction" Content="{DynamicResource EidolonText460}" Command="{Binding Settings.PickGenerationDirectoryCommand}" />
        <Button Grid.Column="2" Classes="folderAction" Command="{Binding Settings.OpenGenerationDirectoryCommand}" ToolTip.Tip="{DynamicResource EidolonText332}" AutomationProperties.Name="{DynamicResource EidolonText332}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource EidolonIconFolder}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
            <TextBlock Text="{DynamicResource EidolonText332}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Text="{DynamicResource EidolonText298}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource EidolonText173}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="{DynamicResource EidolonText342}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !Settings.Session.IsIdle}" />
      <Button Content="{DynamicResource EidolonText182}" Command="{Binding Settings.SaveSettingsCommand}" Classes="primary" HorizontalAlignment="Left" MinWidth="80" />
      <WrapPanel>
        <Button Command="{Binding Settings.OpenLogsCommand}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource EidolonIconFolder}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
            <TextBlock Text="{DynamicResource EidolonText174}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Content="{DynamicResource EidolonText175}" Command="{Binding Settings.OpenDataCommand}" Margin="0,0,0,8" />
      </WrapPanel>
    </StackPanel>
  </StackPanel>
</UserControl>