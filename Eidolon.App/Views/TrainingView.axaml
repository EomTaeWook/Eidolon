<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.TrainingView" x:DataType="vm:StudioViewModel">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="18">
        <StackPanel Spacing="8">
          <TextBlock Text="{DynamicResource EidolonText137}" Classes="title" />
          <TextBlock Text="{DynamicResource EidolonText138}" Classes="muted" />
        </StackPanel>
        <Grid ColumnDefinitions="*,20,380" IsEnabled="{Binding CanQueue}">
          <Border Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource EidolonText140}" Classes="label" />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Text="{Binding DatasetDirectory}" PlaceholderText="{DynamicResource EidolonText141}" IsVisible="{Binding !HasSelectedTrainingImage}" />
                <TextBox Text="{Binding SelectedTrainingImagePath, Mode=OneWay}" IsReadOnly="True" IsVisible="{Binding HasSelectedTrainingImage}" ToolTip.Tip="{Binding SelectedTrainingImagePath}" />
                <Button Grid.Column="1" Content="{Binding PickDatasetCaption}" Command="{Binding PickDatasetCommand}" Margin="8,0,0,0" />
                <Button Grid.Column="2" Command="{Binding OpenDatasetFolderCommand}" Margin="8,0,0,0" ToolTip.Tip="{DynamicResource EidolonText296}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource EidolonIconFolder}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText332}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{DynamicResource EidolonText324}" Classes="muted" FontSize="12" IsVisible="{Binding HasSelectedTrainingImage}" />
              <TextBlock Text="{DynamicResource EidolonText334}" Classes="muted" FontSize="12" IsVisible="{Binding !HasSelectedTrainingImage}" />
              <TextBlock Text="{DynamicResource EidolonText143}" Classes="label" Margin="0,8,0,0" />
              <TextBox Text="{Binding TrainingName}" PlaceholderText="{DynamicResource EidolonText144}" />
              <TextBlock Text="{DynamicResource EidolonText147}" Classes="label" Margin="0,8,0,0" />
              <TextBox Text="{Binding TrainingDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" PlaceholderText="{DynamicResource EidolonText148}" />
              <TextBlock Text="{DynamicResource EidolonText149}" Classes="muted" FontSize="12" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource EidolonText339}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource EidolonText139}" Classes="label" />
              <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssetItem">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{DynamicResource EidolonText335}" Classes="label" Margin="0,8,0,0" />
              <NumericUpDown Value="{Binding TrainingSteps, Mode=TwoWay}" Minimum="{Binding MinimumTrainingSteps}" Maximum="{Binding MaximumTrainingSteps}" Increment="100" FormatString="0" />
              <Grid ColumnDefinitions="*,8,*">
                <Button Content="{DynamicResource EidolonText326}" Command="{Binding QuickTrainingCommand}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Content="{DynamicResource EidolonText336}" Command="{Binding StandardTrainingCommand}" HorizontalAlignment="Stretch" />
              </Grid>
              <TextBlock Text="{Binding TrainingSpeedDescription}" Classes="muted" FontSize="12" />
              <TextBlock Text="{DynamicResource EidolonText145}" Classes="label" Margin="0,8,0,0" />
              <TextBox Text="{Binding TrainingTrigger}" PlaceholderText="{DynamicResource EidolonText146}" />
              <TextBlock Text="{DynamicResource EidolonText337}" Classes="muted" FontSize="12" />
              <CheckBox IsChecked="{Binding ContinueTraining}" Content="{DynamicResource EidolonText259}" Margin="0,8,0,0" />
              <StackPanel Spacing="8" IsVisible="{Binding ContinueTraining}">
                <TextBlock Text="{DynamicResource EidolonText262}" Classes="label" />
                <ComboBox ItemsSource="{Binding Loras}" SelectedItem="{Binding SelectedResumeLora}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetItem">
                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{DynamicResource EidolonText263}" Classes="muted" FontSize="12" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <views:PendingWorkView />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Classes="card" Padding="16" Margin="0,14,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{Binding TrainingSetupHint}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0" />
        <Button Grid.Column="1" Content="{Binding CancelTrainingCaption}" Command="{Binding CancelTrainingCommand}" IsVisible="{Binding ShowTrainingCancel}" Padding="18,12" Margin="0,0,12,0" />
        <Button Grid.Column="2" Classes="primary" Command="{Binding TrainCommand}" Padding="24,12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Data="{StaticResource EidolonIconTraining}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
            <TextBlock Text="{DynamicResource EidolonText250}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
