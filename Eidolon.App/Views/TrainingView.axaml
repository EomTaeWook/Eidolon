<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.TrainingView" x:DataType="vm:TrainingViewModel">
  <UserControl.Styles>
    <Style Selector="Button.trainingStep">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Button.trainingStep.current">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.trainingStep:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.trainingStep Border">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    </Style>
    <Style Selector="Button.trainingStep Border TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current Border">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current Border TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:disabled Border">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:disabled Border TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
    </Style>
    <Style Selector="Button.trainingAdd">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.trainingSecondary">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" MaxWidth="1080" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="6" Margin="0,0,16,0">
        <TextBlock Text="{DynamicResource EidolonText137}" Classes="title" />
        <TextBlock Text="{DynamicResource EidolonText504}" Classes="muted" FontSize="13" />
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Top">
        <TextBlock Text="{Binding Workflow.PositionCaption}" Classes="muted" FontSize="12" />
      </Border>
    </Grid>
    <Border Grid.Row="1" Margin="0,0,-8,16">
      <ItemsControl ItemsSource="{Binding Workflow.Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TrainingStepItem">
            <Button Classes="trainingStep" Classes.current="{Binding IsCurrent}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{Binding Title}">
              <Grid ColumnDefinitions="32,10,*" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="10" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="20" VerticalAlignment="Top">
          <StackPanel Spacing="20">
            <TextBlock Text="{Binding Workflow.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Spacing="16" IsVisible="{Binding Workflow.IsImagesStep}" IsEnabled="{Binding CanEditTrainingInputs}">
              <TextBlock Text="{DynamicResource EidolonText492}" Classes="muted" FontSize="13" />
              <ItemsControl ItemsSource="{Binding TrainingImageGroups}" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrainingImageGroup">
                    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0">
                      <Grid RowDefinitions="Auto,12,*,12,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <Grid ColumnDefinitions="18,8,*" Margin="0,0,8,0">
                            <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Swatch}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding CountCaption}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="2" MinHeight="168" MaxHeight="272">
                          <ScrollViewer IsVisible="{Binding HasImages}" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Images}" Margin="-4,0,0,0">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrainingImageItem">
                                  <Border Width="112" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Margin="4,0,4,8">
                                    <StackPanel Spacing="6">
                                      <Border Height="88" CornerRadius="6" ClipToBounds="True" Background="{ReflectionBinding $parent[ItemsControl].DataContext.Swatch}">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                      </Border>
                                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" FontSize="12" />
                                      <Button Classes="trainingSecondary" Content="{DynamicResource EidolonText443}" Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveImageCommand}" CommandParameter="{Binding}" FontWeight="Normal" Padding="6,4" MinHeight="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasImages}" Margin="12">
                            <Path Data="{StaticResource EidolonIconImage}" Width="32" Height="32" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="{DynamicResource EidolonText467}" Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                          <ProgressBar Height="3" IsIndeterminate="True" VerticalAlignment="Bottom" IsVisible="{Binding IsLoading}" />
                        </Grid>
                        <StackPanel Grid.Row="4" Spacing="8">
                          <Button Classes="trainingAdd" Command="{Binding AddImagesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.5" VerticalAlignment="Center" />
                              <TextBlock Text="{DynamicResource EidolonText463}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <WrapPanel Orientation="Horizontal">
                            <Button Classes="trainingSecondary" Content="{DynamicResource EidolonText464}" Command="{Binding AddFolderCommand}" Margin="0,0,8,4" />
                            <Button Classes="trainingSecondary" Content="{DynamicResource EidolonText469}" Command="{Binding ClearCommand}" IsVisible="{Binding HasImages}" Margin="0,0,0,4" />
                          </WrapPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource EidolonText468}" Classes="muted" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="16" IsVisible="{Binding Workflow.IsIdentityStep}" IsEnabled="{Binding CanEditTrainingInputs}">
              <TextBlock Text="{DynamicResource EidolonText493}" Classes="muted" FontSize="13" />
              <Grid ColumnDefinitions="*,20,*">
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource EidolonText143}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <TextBox Text="{Binding TrainingName}" PlaceholderText="{DynamicResource EidolonText144}" MinHeight="42" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="{DynamicResource EidolonText145}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <TextBox Text="{Binding TrainingTrigger}" PlaceholderText="{DynamicResource EidolonText146}" MinHeight="42" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{DynamicResource EidolonText337}" Classes="muted" FontSize="12" />
              <StackPanel Spacing="8" Margin="0,4,0,0">
                <TextBlock Text="{DynamicResource EidolonText147}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                <TextBox Text="{Binding TrainingDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" MaxHeight="168" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="{DynamicResource EidolonText148}" />
                <TextBlock Text="{DynamicResource EidolonText494}" Classes="muted" FontSize="12" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="20" IsVisible="{Binding Workflow.IsTrainingStep}">
              <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid ColumnDefinitions="*,*">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding TrainingName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TrainingImageSummary}" Classes="muted" FontSize="12" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding TrainingTrigger}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </Border>
              <TextBlock Text="{DynamicResource EidolonText574}" Classes="muted" FontSize="12" />
              <Grid ColumnDefinitions="*,20,*" IsEnabled="{Binding CanEditTrainingInputs}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{DynamicResource EidolonText139}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding Assets.Models}" SelectedItem="{Binding Assets.SelectedModel}" MinHeight="42">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{DynamicResource EidolonText507}" Classes="muted" FontSize="12" />
                  <Button Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" IsVisible="{Binding !Assets.HasAvailableModels}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                  <TextBlock Text="{DynamicResource EidolonText335}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <NumericUpDown Value="{Binding TrainingSteps, Mode=TwoWay}" Minimum="{Binding MinimumTrainingSteps}" Maximum="{Binding MaximumTrainingSteps}" Increment="100" FormatString="0" MinHeight="42" />
                  <Grid ColumnDefinitions="*,8,*">
                    <Button Command="{Binding QuickTrainingCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="38" Padding="10,8" FontSize="13">
                      <TextBlock Text="{DynamicResource EidolonText326}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                    <Button Grid.Column="2" Command="{Binding StandardTrainingCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="38" Padding="10,8" FontSize="13">
                      <TextBlock Text="{DynamicResource EidolonText336}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding TrainingSpeedCaption}" Classes="muted" FontSize="12" />
                </StackPanel>
              </Grid>
              <Expander Header="{DynamicResource EidolonText508}" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanEditTrainingInputs}" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                <StackPanel Spacing="10" Margin="0,12,0,0">
                  <CheckBox IsChecked="{Binding ContinueTraining}" Content="{DynamicResource EidolonText259}" />
                  <ComboBox ItemsSource="{Binding Assets.Loras}" SelectedItem="{Binding SelectedResumeLora}" IsVisible="{Binding ContinueTraining}" MinHeight="42">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{DynamicResource EidolonText263}" Classes="muted" FontSize="12" IsVisible="{Binding ContinueTraining}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </Border>
        <views:PendingWorkView DataContext="{Binding Session}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
      <Grid ColumnDefinitions="2*,3*">
        <TextBlock Text="{Binding Workflow.Hint}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0" />
        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{DynamicResource EidolonText489}" Command="{Binding Workflow.PreviousCommand}" IsVisible="{Binding !Workflow.IsImagesStep}" MinHeight="42" MinWidth="88" Margin="8,4,0,4" />
          <Button Content="{Binding CancelTrainingCaption}" Command="{Binding CancelTrainingCommand}" IsVisible="{Binding ShowTrainingCancel}" MinHeight="42" Margin="8,4,0,4" />
          <Button Content="{DynamicResource EidolonText490}" Command="{Binding Workflow.NextCommand}" IsVisible="{Binding !Workflow.IsTrainingStep}" Classes="primary" MinHeight="42" MinWidth="132" Padding="24,10" Margin="8,4,0,4" />
          <Button Content="{DynamicResource EidolonText474}" Command="{Binding TrainCommand}" IsVisible="{Binding Workflow.IsTrainingStep}" Classes="primary" MinHeight="42" MinWidth="132" Padding="24,10" Margin="8,4,0,4" />
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
