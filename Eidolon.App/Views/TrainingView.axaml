<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.TrainingView" x:DataType="vm:TrainingViewModel">
  <UserControl.Styles>
    <Style Selector="Button.trainingStep">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Button.trainingStep.current">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.trainingStep:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.trainingStep Border">
      <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
    </Style>
    <Style Selector="Button.trainingStep Border TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current Border">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current Border TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:disabled Border">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:disabled Border TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
    </Style>
    <Style Selector="Button.trainingAdd">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.trainingSecondary">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" MaxWidth="1080" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,12">
      <StackPanel Spacing="4">
        <TextBlock Text="{DynamicResource EidolonText137}" Classes="title" />
        <TextBlock Text="{DynamicResource EidolonText504}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Workflow.PositionCaption}" Classes="muted" FontSize="12" VerticalAlignment="Top" Margin="0,5,0,0" />
    </Grid>
    <ItemsControl Grid.Row="1" ItemsSource="{Binding Workflow.Steps}" Margin="0,0,-8,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TrainingStepItem">
          <Button Classes="trainingStep" Classes.current="{Binding IsCurrent}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{Binding Title}">
            <Grid ColumnDefinitions="24,*" ColumnSpacing="8" VerticalAlignment="Center">
              <Border Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Border Classes="card" Padding="16" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding Workflow.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Spacing="12" IsVisible="{Binding Workflow.IsImagesStep}" IsEnabled="{Binding CanEditTrainingInputs}">
              <TextBlock Text="{DynamicResource EidolonText492}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding TrainingImageGroups}" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrainingImageGroup">
                    <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="12" Margin="6,0" VerticalAlignment="Top">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                            <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Swatch}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding CountCaption}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <WrapPanel Orientation="Horizontal">
                          <Button Classes="trainingAdd" Classes.primary="{Binding !HasImages}" Command="{Binding AddImagesCommand}" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.5" VerticalAlignment="Center" />
                              <TextBlock Text="{DynamicResource EidolonText463}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="trainingAdd" Content="{DynamicResource EidolonText464}" Command="{Binding AddFolderCommand}" Margin="0,0,12,4" />
                          <Button Classes="trainingAdd danger" Content="{DynamicResource EidolonText469}" Command="{Binding ClearCommand}" IsVisible="{Binding HasImages}" Margin="0,0,0,4" />
                        </WrapPanel>
                        <ScrollViewer IsVisible="{Binding HasImages}" MaxHeight="220" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                          <ItemsControl ItemsSource="{Binding Images}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:TrainingImageItem">
                                <StackPanel Width="96" Spacing="4" Margin="0,0,8,8">
                                  <Border Height="64" CornerRadius="6" ClipToBounds="True" Background="{ReflectionBinding $parent[ItemsControl].DataContext.Swatch}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                  </Border>
                                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" FontSize="12" />
                                  <Button Classes="trainingSecondary" Content="{DynamicResource EidolonText443}" Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveImageCommand}" CommandParameter="{Binding}" FontWeight="Normal" Padding="6,4" MinHeight="28" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{DynamicResource EidolonText467}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasImages}" />
                        <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource EidolonText468}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding Workflow.IsIdentityStep}" IsEnabled="{Binding CanEditTrainingInputs}">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource EidolonText143}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <TextBox Text="{Binding TrainingName}" PlaceholderText="{DynamicResource EidolonText144}" MinHeight="38" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="{DynamicResource EidolonText145}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <TextBox Text="{Binding TrainingTrigger}" PlaceholderText="{DynamicResource EidolonText146}" ToolTip.Tip="{DynamicResource EidolonText337}" MinHeight="38" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{DynamicResource EidolonText493}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource EidolonText147}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                <TextBox Text="{Binding TrainingDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" MaxHeight="144" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="{DynamicResource EidolonText148}" />
                <TextBlock Text="{DynamicResource EidolonText494}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding Workflow.IsTrainingStep}">
              <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding TrainingName}" ToolTip.Tip="{Binding TrainingName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding TrainingImageSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding TrainingTrigger}" ToolTip.Tip="{Binding TrainingTrigger}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsEnabled="{Binding CanEditTrainingInputs}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource EidolonText139}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding Assets.Models}" SelectedItem="{Binding Assets.SelectedModel}" MinHeight="38" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetItem"><TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{DynamicResource EidolonText507}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <Button Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" IsVisible="{Binding !Assets.HasAvailableModels}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="{DynamicResource EidolonText335}" Classes="label" FontSize="13" Margin="0" TextWrapping="Wrap" />
                  <NumericUpDown Value="{Binding TrainingSteps, Mode=TwoWay}" Minimum="{Binding MinimumTrainingSteps}" Maximum="{Binding MaximumTrainingSteps}" Increment="100" FormatString="0" MinHeight="38" />
                  <Grid ColumnDefinitions="*,8,*">
                    <Button Command="{Binding QuickTrainingCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="38" Padding="10,8" FontSize="13">
                      <TextBlock Text="{DynamicResource EidolonText326}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                    <Button Grid.Column="2" Command="{Binding StandardTrainingCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="38" Padding="10,8" FontSize="13">
                      <TextBlock Text="{DynamicResource EidolonText336}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding TrainingSpeedCaption}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{DynamicResource EidolonText574}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <Expander Header="{DynamicResource EidolonText508}" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanEditTrainingInputs}">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <CheckBox IsChecked="{Binding ContinueTraining}" Content="{DynamicResource EidolonText259}" />
                  <ComboBox ItemsSource="{Binding Assets.Loras}" SelectedItem="{Binding SelectedResumeLora}" IsVisible="{Binding ContinueTraining}" MinHeight="38" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetItem"><TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{DynamicResource EidolonText263}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding ContinueTraining}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </Border>
        <views:PendingWorkView DataContext="{Binding Session}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8" Margin="0,12,0,0">
      <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
        <TextBlock Text="{Binding Workflow.Hint}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{DynamicResource EidolonText489}" Command="{Binding Workflow.PreviousCommand}" IsVisible="{Binding !Workflow.IsImagesStep}" MinHeight="38" MinWidth="84" Margin="8,2,0,2" />
          <Button Content="{Binding CancelTrainingCaption}" Command="{Binding CancelTrainingCommand}" IsVisible="{Binding ShowTrainingCancel}" MinHeight="38" Margin="8,2,0,2" />
          <Button Content="{DynamicResource EidolonText490}" Command="{Binding Workflow.NextCommand}" IsVisible="{Binding !Workflow.IsTrainingStep}" Classes="primary" MinHeight="38" MinWidth="112" Padding="16,8" Margin="8,2,0,2" />
          <Button Content="{DynamicResource EidolonText474}" Command="{Binding TrainCommand}" IsVisible="{Binding Workflow.IsTrainingStep}" Classes="primary" MinHeight="38" MinWidth="112" Padding="16,8" Margin="8,2,0,2" />
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
