<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.TrainingView" x:DataType="vm:TrainingViewModel">
  <UserControl.Styles>
    <Style Selector="Button.trainingStep">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,12" />
    </Style>
    <Style Selector="Button.trainingStep.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep:disabled">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.trainingStep:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="Button.trainingStep Border">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current Border">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.trainingStep.current Border TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.trainingAdd">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.trainingSecondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.trainingSecondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto" MaxWidth="1080" HorizontalAlignment="Stretch">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="6">
        <TextBlock Text="{DynamicResource EidolonText137}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource EidolonText504}" Classes="muted" FontSize="13" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding Workflow.PositionCaption}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="20,0,0,0" />
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,18">
      <ItemsControl ItemsSource="{Binding Workflow.Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TrainingStepItem">
            <Button Classes="trainingStep" Classes.current="{Binding IsCurrent}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{Binding Title}">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="13">
                  <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="24" VerticalAlignment="Top">
          <StackPanel Spacing="20">
            <TextBlock Text="{Binding Workflow.Title}" FontSize="20" FontWeight="SemiBold" />
            <StackPanel Spacing="16" IsVisible="{Binding Workflow.IsImagesStep}" IsEnabled="{Binding CanEditTrainingInputs}">
              <TextBlock Text="{DynamicResource EidolonText492}" Classes="muted" FontSize="13" />
              <ItemsControl ItemsSource="{Binding TrainingImageGroups}" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrainingImageGroup">
                    <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="16" Margin="6,0">
                      <Grid RowDefinitions="Auto,8,*,8,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="4" Background="{Binding Swatch}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding CountCaption}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="2" MinHeight="160" MaxHeight="260">
                          <ScrollViewer IsVisible="{Binding HasImages}" AllowAutoHide="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Images}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrainingImageItem">
                                  <Grid ColumnDefinitions="44,8,*,Auto" Margin="0,4">
                                    <Border Width="44" Height="44" CornerRadius="5" ClipToBounds="True" Background="{ReflectionBinding $parent[ItemsControl].DataContext.Swatch}">
                                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FilePath}" VerticalAlignment="Center" FontSize="12" />
                                    <Button Grid.Column="3" Classes="trainingSecondary" Content="{DynamicResource EidolonText443}" Command="{ReflectionBinding $parent[ItemsControl].DataContext.RemoveImageCommand}" CommandParameter="{Binding}" FontSize="11" Padding="6,4" Margin="4,0,0,0" VerticalAlignment="Center" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                          <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasImages}" Margin="12">
                            <Path Data="{StaticResource EidolonIconImage}" Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource EidolonText467}" Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                          </StackPanel>
                          <ProgressBar Height="3" IsIndeterminate="True" VerticalAlignment="Bottom" IsVisible="{Binding IsLoading}" />
                        </Grid>
                        <StackPanel Grid.Row="4" Spacing="8">
                          <Button Classes="trainingAdd" Command="{Binding AddImagesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.5" VerticalAlignment="Center" />
                              <TextBlock Text="{DynamicResource EidolonText463}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="trainingSecondary" Content="{DynamicResource EidolonText464}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Classes="trainingSecondary" Content="{DynamicResource EidolonText469}" Command="{Binding ClearCommand}" IsVisible="{Binding HasImages}" />
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{DynamicResource EidolonText468}" Classes="muted" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="14" IsVisible="{Binding Workflow.IsIdentityStep}" IsEnabled="{Binding CanEditTrainingInputs}">
              <TextBlock Text="{DynamicResource EidolonText493}" Classes="muted" FontSize="13" />
              <Grid ColumnDefinitions="*,24,*">
                <StackPanel Spacing="6">
                  <TextBlock Text="{DynamicResource EidolonText143}" Classes="label" />
                  <TextBox Text="{Binding TrainingName}" PlaceholderText="{DynamicResource EidolonText144}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6">
                  <TextBlock Text="{DynamicResource EidolonText145}" Classes="label" />
                  <TextBox Text="{Binding TrainingTrigger}" PlaceholderText="{DynamicResource EidolonText146}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{DynamicResource EidolonText337}" Classes="muted" FontSize="12" />
              <TextBlock Text="{DynamicResource EidolonText147}" Classes="label" Margin="0,10,0,0" />
              <TextBox Text="{Binding TrainingDescription}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" PlaceholderText="{DynamicResource EidolonText148}" />
              <TextBlock Text="{DynamicResource EidolonText494}" Classes="muted" FontSize="12" />
            </StackPanel>
            <StackPanel Spacing="18" IsVisible="{Binding Workflow.IsDatasetStep}">
              <TextBlock Text="{DynamicResource EidolonText496}" Classes="muted" FontSize="13" />
              <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="18">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding TrainingName}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding TrainingImageSummary}" Classes="muted" FontSize="13" />
                  <TextBlock Text="{Binding TrainingTrigger}" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
              </Border>
              <Button Classes="primary" Command="{Binding Dataset.CreateCommand}" HorizontalAlignment="Left" Padding="18,10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Data="{StaticResource EidolonIconFolder}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                  <TextBlock Text="{DynamicResource EidolonText471}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding Dataset.IsPreparing}" />
              <StackPanel Spacing="10" IsVisible="{Binding Dataset.HasPrepared}">
                <SelectableTextBlock Text="{Binding Dataset.Path}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <Button Content="{DynamicResource EidolonText491}" Command="{Binding Dataset.OpenCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="18" IsVisible="{Binding Workflow.IsCaptionsStep}">
              <TextBlock Text="{DynamicResource EidolonText505}" Classes="muted" FontSize="13" />
              <Button Content="{DynamicResource EidolonText491}" Command="{Binding Dataset.OpenCommand}" HorizontalAlignment="Left" />
              <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="18">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText503}" FontWeight="SemiBold" FontSize="13" />
                  <SelectableTextBlock Text="{Binding CaptionExample}" TextWrapping="Wrap" FontSize="14" />
                </StackPanel>
              </Border>
              <TextBlock Text="{DynamicResource EidolonText506}" Classes="muted" FontSize="12" />
              <SelectableTextBlock Text="{Binding Dataset.Path}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="18" IsVisible="{Binding Workflow.IsTrainingStep}">
              <Border Background="{DynamicResource WindowBrush}" CornerRadius="8" Padding="18">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding TrainingName}" FontSize="16" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding Dataset.Path}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding TrainingTrigger}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="20,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,24,*" IsEnabled="{Binding CanEditTrainingInputs}">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText139}" Classes="label" />
                  <ComboBox ItemsSource="{Binding Assets.Models}" SelectedItem="{Binding Assets.SelectedModel}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{DynamicResource EidolonText507}" Classes="muted" FontSize="12" />
                  <Button Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" IsVisible="{Binding !Assets.HasAvailableModels}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText335}" Classes="label" />
                  <NumericUpDown Value="{Binding TrainingSteps, Mode=TwoWay}" Minimum="{Binding MinimumTrainingSteps}" Maximum="{Binding MaximumTrainingSteps}" Increment="100" FormatString="0" />
                  <Grid ColumnDefinitions="*,8,*">
                    <Button Content="{DynamicResource EidolonText326}" Command="{Binding QuickTrainingCommand}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="2" Content="{DynamicResource EidolonText336}" Command="{Binding StandardTrainingCommand}" HorizontalAlignment="Stretch" />
                  </Grid>
                  <TextBlock Text="{Binding TrainingSpeedCaption}" Classes="muted" FontSize="12" />
                </StackPanel>
              </Grid>
              <Expander Header="{DynamicResource EidolonText508}" HorizontalContentAlignment="Stretch" IsEnabled="{Binding CanEditTrainingInputs}">
                <StackPanel Spacing="10" Margin="0,12,0,0">
                  <CheckBox IsChecked="{Binding ContinueTraining}" Content="{DynamicResource EidolonText259}" />
                  <ComboBox ItemsSource="{Binding Assets.Loras}" SelectedItem="{Binding SelectedResumeLora}" IsVisible="{Binding ContinueTraining}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetItem"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{DynamicResource EidolonText263}" Classes="muted" FontSize="12" IsVisible="{Binding ContinueTraining}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </Border>
        <views:PendingWorkView DataContext="{Binding Session}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Text="{Binding Workflow.Hint}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0" />
        <Button Grid.Column="1" Content="{DynamicResource EidolonText489}" Command="{Binding Workflow.PreviousCommand}" IsVisible="{Binding !Workflow.IsImagesStep}" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="{Binding CancelTrainingCaption}" Command="{Binding CancelTrainingCommand}" IsVisible="{Binding ShowTrainingCancel}" Margin="0,0,8,0" />
        <Button Grid.Column="3" Content="{DynamicResource EidolonText490}" Command="{Binding Workflow.NextCommand}" IsVisible="{Binding !Workflow.IsTrainingStep}" Classes="primary" Padding="24,10" />
        <Button Grid.Column="4" Content="{DynamicResource EidolonText474}" Command="{Binding TrainCommand}" IsVisible="{Binding Workflow.IsTrainingStep}" Classes="primary" Padding="24,10" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
