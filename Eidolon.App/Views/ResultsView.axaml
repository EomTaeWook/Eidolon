<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.ResultsView" x:DataType="vm:GalleryViewModel">
  <UserControl.Resources>
    <x:Int32 x:Key="ResultsGalleryColumns">2</x:Int32>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.resultCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.resultCard">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.resultCard">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="GridSplitter.resultsSplitter">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="Transparent">
            <Border Width="1" Background="{DynamicResource BorderBrush}" HorizontalAlignment="Center" Margin="0,8" />
            <Border Classes="splitHandle" Width="4" Height="36" CornerRadius="2" Background="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.resultsSplitter:pointerover /template/ Border.splitHandle">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="GridSplitter.resultsSplitter:focus-visible /template/ Border.splitHandle">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.resultAction">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.resultAction:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.resultAction:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.resultAction:disabled">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
    </Style>
    <Style Selector="Button.resultAction:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DisabledBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource EidolonText372}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding GalleryCountCaption}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Command="{Binding OpenImageFolderCommand}" Padding="12,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource EidolonIconFolder}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
            <TextBlock Text="{DynamicResource EidolonText296}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Content="{DynamicResource EidolonText273}" Command="{Binding RefreshGalleryCommand}" Padding="12,8" />
        <Button Content="{DynamicResource EidolonText317}" Command="{Binding DeleteAllGenerationsCommand}" IsVisible="{Binding HasGenerations}" Padding="12,8" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,12,0,14">
      <TextBlock Text="{DynamicResource EidolonText373}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
      <Border Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding HasGalleryError}">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource EidolonText380}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <SelectableTextBlock Text="{Binding GalleryError}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="440" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="400" MinWidth="360" MaxWidth="640" />
      </Grid.ColumnDefinitions>
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8" IsVisible="{Binding HasGenerations}">
          <TextBlock Text="{Binding GallerySelectionCaption}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
          <Button Grid.Column="1" Content="{DynamicResource EidolonText387}" Command="{Binding ClearGallerySelectionCommand}" Padding="10,7" Margin="0,0,8,0" />
          <Button Grid.Column="2" Content="{DynamicResource EidolonText316}" Command="{Binding DeleteGenerationCommand}" Padding="10,7" />
        </Grid>
        <ListBox x:Name="Gallery" Grid.Row="1" ItemsSource="{Binding Generations}" SelectedItems="{Binding GallerySelection, Mode=OneWay}" SelectionMode="Multiple" IsEnabled="{Binding !IsGalleryLoading}" Margin="-6,0" Background="Transparent" BorderThickness="0" ScrollViewer.AllowAutoHide="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" KeyDown="OnGalleryKeyDown">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{DynamicResource ResultsGalleryColumns}" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GenerationItem">
              <Border Classes="resultCard" AutomationProperties.Name="{Binding Label}">
                <Grid RowDefinitions="170,Auto">
                  <Border Background="{DynamicResource WindowBrush}" CornerRadius="9,9,0,0" ClipToBounds="True">
                    <Grid>
                      <views:TransparencyBackground IsVisible="{Binding HasThumbnail}" />
                      <Image Source="{Binding Thumbnail}" Stretch="Uniform" IsVisible="{Binding HasThumbnail}" />
                      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}">
                        <Path Data="{StaticResource EidolonIconImage}" Width="30" Height="30" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" />
                        <TextBlock Text="{Binding ThumbnailCaption}" Classes="muted" FontSize="12" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Row="1" Spacing="6" Margin="12,10">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileName}" />
                    <TextBlock Text="{Binding Metadata.Model.Name, FallbackValue=''}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsVisible="{Binding HasMetadata}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding CreatedCaption}" Classes="muted" FontSize="11" />
                      <TextBlock Grid.Column="1" Text="{Binding StateCaption}" Classes="muted" FontSize="11" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsGalleryEmpty}" MaxWidth="320" Margin="12,16">
          <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource BadgeBrush}" HorizontalAlignment="Center">
            <Path Data="{StaticResource EidolonIconImage}" Width="26" Height="26" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{DynamicResource EidolonText325}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource EidolonText304}" Classes="muted" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
          <Button Content="{DynamicResource EidolonText106}" Command="{Binding Navigation.ShowGenerationCommand}" HorizontalAlignment="Center" Padding="16,7" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding IsGalleryLoading}">
            <ProgressBar IsIndeterminate="True" Width="60" Height="4" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource EidolonText378}" Classes="muted" FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" IsVisible="{Binding HasGenerations}">
            <Button Content="{DynamicResource EidolonText374}" Command="{Binding PreviousGalleryPageCommand}" Padding="12,8" />
            <TextBlock Text="{Binding GalleryPageCaption}" VerticalAlignment="Center" MinWidth="90" TextAlignment="Center" />
            <Button Content="{DynamicResource EidolonText375}" Command="{Binding NextGalleryPageCommand}" Padding="12,8" />
          </StackPanel>
        </StackPanel>
      </Grid>
      <GridSplitter Grid.Column="1" Classes="resultsSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Focusable="True" Cursor="SizeWestEast" />
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding HasSelectedResult}">
        <StackPanel Spacing="7" Margin="0,0,0,10">
          <TextBlock Text="{Binding SelectedResult.Label}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedResult.Label}" />
          <WrapPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SelectedResult.Metadata.Model.Name, FallbackValue=''}" Classes="muted" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" IsVisible="{Binding SelectedResult.HasMetadata}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0" IsVisible="{Binding SelectedResult.HasMetadata}">
              <TextBlock Text="{DynamicResource EidolonText369}" Classes="muted" FontSize="12" />
              <SelectableTextBlock Text="{Binding SelectedResult.SeedCaption}" FontSize="12" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedResult.DimensionsCaption}" Classes="muted" FontSize="12" />
          </WrapPanel>
        </StackPanel>
        <Border Grid.Row="1" Height="280" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" ClipToBounds="True">
          <Grid>
            <views:TransparencyBackground IsVisible="{Binding HasPreview}" />
            <Image Source="{Binding Preview}" Stretch="Uniform" IsVisible="{Binding HasPreview}" />
            <TextBlock Text="{DynamicResource EidolonText307}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16" IsVisible="{Binding !HasPreview}" />
          </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,8,*" RowDefinitions="36,8,36" Margin="0,10,0,12">
          <Button Command="{Binding ExportCommand}" Classes="resultAction" ToolTip.Tip="{DynamicResource EidolonText122}">
            <Grid ColumnDefinitions="16,8,*">
              <Path Data="{StaticResource EidolonIconSave}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{DynamicResource EidolonText122}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button Grid.Column="2" Command="{Binding ReusePromptCommand}" Classes="resultAction" ToolTip.Tip="{DynamicResource EidolonText121}">
            <Grid ColumnDefinitions="16,8,*">
              <Path Data="{StaticResource EidolonIconPlay}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{DynamicResource EidolonText121}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button Grid.Row="2" Command="{Binding UseResultAsReferenceCommand}" Classes="resultAction" ToolTip.Tip="{DynamicResource EidolonText455}">
            <Grid ColumnDefinitions="16,8,*">
              <Path Data="{StaticResource EidolonIconEdit}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{DynamicResource EidolonText455}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
          <Button Grid.Row="2" Grid.Column="2" Command="{Binding UseResultForTrainingCommand}" Classes="resultAction" ToolTip.Tip="{DynamicResource EidolonText305}">
            <Grid ColumnDefinitions="16,8,*">
              <Path Data="{StaticResource EidolonIconTraining}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{DynamicResource EidolonText295}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Button>
        </Grid>
        <Border Grid.Row="3" Classes="card" Padding="14">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
            <StackPanel Spacing="12">
              <views:PromptDetailsView DataContext="{Binding SelectedResult}" />
              <TextBlock Text="{DynamicResource EidolonText388}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !SelectedResult.HasMetadata}" />
              <Border Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding SelectedResult.HasError}">
                <TextBlock Text="{Binding SelectedResult.ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12" />
              </Border>
              <StackPanel Spacing="8" IsVisible="{Binding SelectedResult.HasAppliedLoras}">
                <TextBlock Text="LoRA" Classes="label" />
                <SelectableTextBlock Text="{Binding SelectedResult.AppliedLoras}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Height="1" Background="{DynamicResource BorderBrush}" />
              <SelectableTextBlock Text="{Binding SelectedResult.FileName}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                <TextBlock Text="{DynamicResource EidolonText367}" Classes="muted" FontSize="12" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedResult.CreatedCaption}" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{Binding SelectedResult.StateCaption}" Classes="muted" FontSize="12" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
      <StackPanel Grid.Column="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSelectedResult}" MaxWidth="340" Margin="16">
        <Path Data="{StaticResource EidolonIconImage}" Width="40" Height="40" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" />
        <TextBlock Text="{DynamicResource EidolonText424}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
