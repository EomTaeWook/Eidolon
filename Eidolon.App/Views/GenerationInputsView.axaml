<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.Views.GenerationInputsView" x:DataType="vm:GenerationViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
  </UserControl.Styles>
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
    <StackPanel Spacing="12">
      <StackPanel Spacing="8" IsEnabled="{Binding Session.CanEditGenerationInputs}" IsVisible="{Binding Navigation.IsGenerationView}">
        <TextBlock Text="{DynamicResource EidolonText112}" FontSize="14" FontWeight="SemiBold" />
        <TextBox Text="{Binding Prompt, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="140" PlaceholderText="{DynamicResource EidolonText114}" />
      </StackPanel>
      <views:EditingInputsView IsVisible="{Binding Navigation.IsEditingView}" />
        <Button Classes="primary" Command="{Binding GenerationSubmitCommand}" MinWidth="140" MinHeight="42" CornerRadius="6" FontSize="14" HorizontalAlignment="Right" ToolTip.Tip="{DynamicResource EidolonText248}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Data="{StaticResource EidolonIconPlay}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GenerationActionCaption}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      <SelectableTextBlock Text="{Binding QueuedGenerationSeedCaption}" IsVisible="{Binding HasQueuedGenerationSeed}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
      <views:PendingWorkView DataContext="{Binding Session}" />
    </StackPanel>
  </Border>
</UserControl>
