<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" x:Class="Eidolon.App.Views.JobDetailsView" x:DataType="vm:StudioViewModel" IsVisible="{Binding HasSelectedJob}">
        <Expander Header="{DynamicResource EidolonText198}" MaxHeight="210">
          <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
              <Button Content="{DynamicResource EidolonText199}" Command="{Binding OpenJobCommand}" Padding="12,6" />
              <Button Command="{Binding OpenLogsCommand}" Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Path Data="{StaticResource EidolonIconFolder}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="2.2" />
                  <TextBlock Text="{DynamicResource EidolonText174}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Content="{DynamicResource EidolonText200}" Command="{Binding ReloadCommand}" Padding="12,6" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" MaxHeight="140">
              <StackPanel Spacing="10">
                <SelectableTextBlock Text="{Binding SelectedJob.Description}" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Expander>
</UserControl>
