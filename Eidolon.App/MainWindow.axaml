<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.MainWindow" x:DataType="vm:StudioViewModel" Title="Eidolon" Icon="/Assets/AppIcon.ico" Width="1280" Height="900" MinWidth="1024" MinHeight="740" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*" Margin="24,10">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image Source="/Assets/AppIcon.png" Width="32" Height="32" />
          <TextBlock Text="Eidolon" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Command="{Binding Navigation.ShowGenerationCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsGenerationView}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
              <TextBlock Text="{DynamicResource EidolonText106}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowEditingCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsEditingView}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Data="{StaticResource EidolonIconEdit}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
              <TextBlock Text="{DynamicResource EidolonText456}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowResultsCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsResultsView}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Data="{StaticResource EidolonIconResults}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
              <TextBlock Text="{DynamicResource EidolonText291}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowTrainingCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsTrainingView}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Data="{StaticResource EidolonIconTraining}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
              <TextBlock Text="{DynamicResource EidolonText108}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowGenerationEnvironmentCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsEngineView}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Data="{StaticResource EidolonIconEngine}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
              <TextBlock Text="{DynamicResource EidolonText560}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowSettingsCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsSettingsView}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Data="{StaticResource EidolonIconSettings}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
              <TextBlock Text="{DynamicResource EidolonText110}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowHelpCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsHelpView}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Path Data="{StaticResource EidolonIconHelp}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
              <TextBlock Text="{DynamicResource EidolonText111}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24,0,24,16">
      <Border IsVisible="{Binding Navigation.IsGenerationWorkspace}">
        <Grid ColumnDefinitions="360,18,*" Margin="0,18,0,0">
          <views:GenerationInputsView Grid.Column="0" DataContext="{Binding Generation}" />
          <views:GenerationPreviewView Grid.Column="2" DataContext="{Binding Gallery}" />
        </Grid>
      </Border>
      <Border IsVisible="{Binding Navigation.IsResultsView}">
        <views:ResultsView Margin="0,18,0,0" DataContext="{Binding Gallery}" />
      </Border>
      <Border IsVisible="{Binding Navigation.IsTrainingView}">
        <views:TrainingView Margin="0,18,0,0" DataContext="{Binding Training}" />
      </Border>
      <Border IsVisible="{Binding Navigation.IsEngineView}">
        <TabControl SelectedIndex="{Binding Navigation.SelectedEngineTab}" Margin="0,12,0,0">
          <TabControl.Styles>
            <Style Selector="TabItem">
              <Setter Property="FontSize" Value="14" />
              <Setter Property="Padding" Value="18,10" />
            </Style>
          </TabControl.Styles>
          <TabItem Header="{DynamicResource EidolonText570}">
            <views:GenerationEnvironmentView DataContext="{Binding Settings}" />
          </TabItem>
          <TabItem Header="{DynamicResource EidolonText152}">
            <views:EngineView DataContext="{Binding Engine}" />
          </TabItem>
          <TabItem Header="{DynamicResource EidolonText107}">
            <views:ModelsView DataContext="{Binding Assets}" />
          </TabItem>
        </TabControl>
      </Border>
      <Border IsVisible="{Binding Navigation.IsSettingsView}">
        <views:SettingsView DataContext="{Binding Settings}" />
      </Border>
      <Border IsVisible="{Binding Navigation.IsHelpView}">
        <ScrollViewer Margin="0,18,0,0" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource EidolonText184}" Classes="title" />
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText185}" Classes="title" FontSize="21" />
                <TextBlock Text="{DynamicResource EidolonText186}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText187}" Classes="muted" />
                <TextBlock Text="{DynamicResource EidolonText285}" Classes="muted" />
                <Button Command="{Binding Navigation.ShowGenerationEnvironmentCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="{StaticResource EidolonIconEngine}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText560}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Content="{DynamicResource EidolonText110}" Command="{Binding Navigation.ShowSettingsCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText563}" Classes="title" FontSize="21" />
                <TextBlock Text="{DynamicResource EidolonText565}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText566}" Classes="muted" />
                <TextBlock Text="{DynamicResource EidolonText567}" Classes="muted" />
                <Button Content="{DynamicResource EidolonText560}" Command="{Binding Navigation.ShowGenerationEnvironmentCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText568}" Classes="title" FontSize="21" />
                <TextBlock Text="{DynamicResource EidolonText569}" TextWrapping="Wrap" />
                <Button Content="{DynamicResource EidolonText107}" Command="{Binding Navigation.ShowModelsCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText188}" Classes="title" FontSize="21" />
                <TextBlock Text="{DynamicResource EidolonText189}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText190}" Classes="muted" />
                <TextBlock Text="{DynamicResource EidolonText303}" Classes="muted" />
                <TextBlock Text="{DynamicResource EidolonText305}" Classes="muted" />
                <TextBlock Text="{DynamicResource EidolonText480}" Classes="muted" />
                <Button Command="{Binding Navigation.ShowGenerationCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText106}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText476}" Classes="title" FontSize="21" />
                <TextBlock Text="{DynamicResource EidolonText477}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText479}" Classes="muted" />
                <Button Command="{Binding Navigation.ShowEditingCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="{StaticResource EidolonIconEdit}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText456}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText191}" Classes="title" FontSize="21" />
                <TextBlock Text="{DynamicResource EidolonText192}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText193}" Classes="muted" />
                <Button Command="{Binding Navigation.ShowTrainingCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="{StaticResource EidolonIconTraining}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                    <TextBlock Text="{DynamicResource EidolonText108}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource EidolonText194}" Classes="title" FontSize="21" />
                <TextBlock Text="{DynamicResource EidolonText195}" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource EidolonText196}" Classes="muted" />
                <Button Command="{Binding Settings.OpenLogsCommand}" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Path Data="{StaticResource EidolonIconFolder}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="2.2" />
                    <TextBlock Text="{DynamicResource EidolonText174}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,14">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Session.Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.Status}" VerticalAlignment="Center" />
        <ProgressBar Value="{Binding Session.Percent}" IsIndeterminate="{Binding Session.Indeterminate}" IsVisible="{Binding Session.IsBusy}" Height="4" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="{Binding Session.ActiveRequestTitle}" IsVisible="{Binding Session.IsBusy}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.ActiveRequestTitle}" TextWrapping="NoWrap" />
        <TextBlock Text="{Binding Training.TrainingRemainingText}" IsVisible="{Binding Training.ShowTrainingRemainingTime}" Classes="muted" FontSize="12" />
        <TextBlock Text="{Binding Session.QueueSummary}" IsVisible="{Binding Session.HasPendingRequests}" Classes="muted" FontSize="12" />
        <Border IsVisible="{Binding Session.HasError}" Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="7" Padding="12">
          <TextBlock Text="{Binding Session.Error}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" MaxHeight="100" />
        </Border>

      </StackPanel>
    </Border>
  </Grid>
</Window>
