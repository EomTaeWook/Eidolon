<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Eidolon.App.ViewModels" xmlns:views="using:Eidolon.App.Views" x:Class="Eidolon.App.MainWindow" x:DataType="vm:StudioViewModel" Title="Eidolon" Icon="/Assets/AppIcon.ico" Width="1280" Height="900" MinWidth="1024" MinHeight="740" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="views|GenerationInputsView">
      <Setter Property="DockPanel.Dock" Value="Bottom" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,12">
      <Grid ColumnDefinitions="Auto,24,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="3" Height="28" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
          <Image Source="/Assets/AppIcon.png" Width="28" Height="28" />
          <TextBlock Text="Eidolon" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <WrapPanel Grid.Column="2" VerticalAlignment="Center">
          <Button Command="{Binding Navigation.ShowGenerationCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsGenerationView}" Padding="10,8" CornerRadius="6" FontSize="13" Margin="0,2,4,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource EidolonIconImage}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource EidolonText106}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowEditingCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsEditingView}" Padding="10,8" CornerRadius="6" FontSize="13" Margin="0,2,4,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource EidolonIconEdit}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource EidolonText456}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowResultsCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsResultsView}" Padding="10,8" CornerRadius="6" FontSize="13" Margin="0,2,4,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource EidolonIconResults}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource EidolonText291}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowAssetCreationCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsAssetCreationView}" Padding="10,8" CornerRadius="6" FontSize="13" Margin="0,2,4,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource EidolonIconResults}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource EidolonText603}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Command="{Binding Navigation.ShowTrainingCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsTrainingView}" Padding="10,8" CornerRadius="6" FontSize="13" Margin="0,2,4,2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="{StaticResource EidolonIconTraining}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
              <TextBlock Text="{DynamicResource EidolonText108}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Command="{Binding Navigation.ShowGenerationEnvironmentCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsGenerationEnvironmentView}" Padding="8" CornerRadius="6" ToolTip.Tip="{DynamicResource EidolonText581}" AutomationProperties.Name="{DynamicResource EidolonText581}">
            <Path Data="{StaticResource EidolonIconLibrary}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
          </Button>
          <Button Command="{Binding Navigation.ShowSettingsCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsSettingsView}" Padding="8" CornerRadius="6" ToolTip.Tip="{DynamicResource EidolonText110}" AutomationProperties.Name="{DynamicResource EidolonText110}">
            <Path Data="{StaticResource EidolonIconSettings}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
          </Button>
          <Button Command="{Binding Navigation.ShowHelpCommand}" Classes="navigation" Classes.active="{Binding Navigation.IsHelpView}" Padding="8" CornerRadius="6" ToolTip.Tip="{DynamicResource EidolonText111}" AutomationProperties.Name="{DynamicResource EidolonText111}">
            <Path Data="{StaticResource EidolonIconHelp}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24,20,24,16">
      <Border IsVisible="{Binding Navigation.IsGenerationWorkspace}">
        <Grid RowDefinitions="Auto,12,*,12,Auto" ColumnDefinitions="*,16,260">
          <Border Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
              <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Generation.GenerationInputCaption}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Generation.IsComfyGeneration}" VerticalAlignment="Center" Margin="0,2,12,2">
                  <ComboBox ItemsSource="{Binding Assets.Models}" SelectedItem="{Binding Assets.SelectedModel, Mode=TwoWay}" IsVisible="{Binding Assets.HasAvailableModels}" IsEnabled="{Binding Session.CanEditGenerationInputs}" Width="220" MinHeight="40" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" ToolTip.Tip="{DynamicResource EidolonText359}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AssetItem">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="13" ToolTip.Tip="{Binding Detail}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="{Binding Assets.ModelSetupActionCaption}" Command="{Binding Assets.PrepareModelsCommand}" IsVisible="{Binding !Assets.HasAvailableModels}" ToolTip.Tip="{Binding Assets.ModelSetupHint}" />
                  <DropDownButton Width="220" MinHeight="40" Padding="12,8" CornerRadius="8" HorizontalContentAlignment="Stretch" IsEnabled="{Binding Session.CanEditGenerationInputs}" ToolTip.Tip="{Binding Assets.SelectedLoraNames}" AutomationProperties.Name="{DynamicResource EidolonText423}">
                    <Grid>
                      <TextBlock Text="{DynamicResource EidolonText423}" IsVisible="{Binding !Assets.HasSelectedLoras}" FontSize="13" />
                      <TextBlock Text="{Binding Assets.SelectedLoraNames}" IsVisible="{Binding Assets.HasSelectedLoras}" TextTrimming="CharacterEllipsis" FontSize="13" />
                    </Grid>
                    <DropDownButton.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="320" Spacing="10">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{DynamicResource EidolonText423}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Assets.SelectedLorasCaption}" IsVisible="{Binding Assets.HasSelectedLoras}" Classes="muted" FontSize="11" />
                          </Grid>
                          <TextBox Text="{Binding Assets.LoraSearch, Mode=TwoWay}" PlaceholderText="{DynamicResource EidolonText432}" IsVisible="{Binding Assets.ShowLoraSearch}" FontSize="13" />
                          <TextBlock Text="{DynamicResource EidolonText341}" IsVisible="{Binding !Assets.HasAvailableLoras}" Classes="muted" FontSize="12" />
                          <Border IsVisible="{Binding Assets.HasAvailableLoras}">
                            <TextBlock Text="{DynamicResource EidolonText433}" IsVisible="{Binding !Assets.HasMatchingLoras}" Classes="muted" FontSize="12" />
                          </Border>
                          <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding Assets.HasMatchingLoras}">
                            <ItemsControl ItemsSource="{Binding Assets.FilteredLoras}">
                              <ItemsControl.Styles>
                                <Style Selector="ToggleButton.loraRow">
                                  <Setter Property="HorizontalAlignment" Value="Stretch" />
                                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                  <Setter Property="Background" Value="Transparent" />
                                  <Setter Property="BorderThickness" Value="0" />
                                  <Setter Property="CornerRadius" Value="4" />
                                  <Setter Property="Padding" Value="10" />
                                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Style>
                                <Style Selector="ToggleButton.loraRow:checked">
                                  <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Style>
                                <Style Selector="ToggleButton.loraRow:checked /template/ ContentPresenter">
                                  <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Style>
                                <Style Selector="ToggleButton.loraRow:pointerover /template/ ContentPresenter">
                                  <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
                                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </Style>
                                <Style Selector="ToggleButton.loraRow:checked:pointerover /template/ ContentPresenter">
                                  <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
                                  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Style>
                              </ItemsControl.Styles>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AssetItem">
                                  <ToggleButton Classes="loraRow" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip.Tip="{Binding TriggerCaption}" AutomationProperties.Name="{Binding Label}">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                      <TextBlock Grid.Column="1" Text="{DynamicResource EidolonText435}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsSelected}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                  </ToggleButton>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                      </Flyout>
                    </DropDownButton.Flyout>
                  </DropDownButton>
                  <Button Content="{DynamicResource EidolonText410}" Command="{Binding Assets.ScanCommand}" Padding="10,8" ToolTip.Tip="{DynamicResource EidolonText125}" />
                </StackPanel>
                <TextBlock Text="{Binding Session.CodexModelCaption}" IsVisible="{Binding !Generation.IsComfyGeneration}" Classes="muted" FontSize="13" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource EidolonText545}" />
              </WrapPanel>
              <Button Grid.Column="1" Command="{Binding Navigation.ShowGenerationEnvironmentCommand}" CornerRadius="8" Padding="10,8" ToolTip.Tip="{DynamicResource EidolonText560}" AutomationProperties.Name="{DynamicResource EidolonText560}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Session.GenerationBackendCaption}" FontSize="13" VerticalAlignment="Center" />
                  <Path Data="{StaticResource EidolonIconSettings}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <DockPanel Grid.Row="2" Grid.RowSpan="3">
            <views:GenerationInputsView DataContext="{Binding Generation}" HorizontalAlignment="Stretch" />
            <Grid>
              <Grid IsVisible="{Binding Navigation.IsGenerationView}">
                <views:GenerationResultView DataContext="{Binding Generation}" />
              </Grid>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" IsVisible="{Binding Navigation.IsEditingView}">
                <views:EditingMaskView DataContext="{Binding Generation}" />
              </Border>
            </Grid>
          </DockPanel>
          <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" DataContext="{Binding Generation}" x:DataType="vm:GenerationViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="20" IsEnabled="{Binding Session.CanEditGenerationInputs}">
                <views:ReferenceImageInputsView />
                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <StackPanel Spacing="8" IsVisible="{Binding IsComfyGeneration}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{DynamicResource EidolonText369}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Content="{DynamicResource EidolonText419}" IsChecked="{Binding UseRandomGenerationSeed, Mode=TwoWay}" FontSize="12" />
                  </Grid>
                  <TextBox Text="{Binding GenerationSeed, Mode=TwoWay}" IsEnabled="{Binding !UseRandomGenerationSeed}" FontSize="14" MinHeight="38" AutomationProperties.Name="{DynamicResource EidolonText369}" />
                  <TextBlock Text="{Binding GenerationSeedValidationHint}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding !IsGenerationSeedValid}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding RemoveBackground, Mode=TwoWay}" Content="{DynamicResource EidolonText308}" ToolTip.Tip="{DynamicResource EidolonText309}" FontSize="13" MinHeight="28" />
                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <StackPanel Spacing="10" ToolTip.Tip="{DynamicResource EidolonText437}">
                  <TextBlock Text="{DynamicResource EidolonText176}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText362}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                  <SelectableTextBlock Text="{Binding GenerationPositivePrompt}" TextWrapping="Wrap" FontSize="13" />
                  <TextBlock Text="{DynamicResource EidolonText180}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                  <SelectableTextBlock Text="{Binding GenerationNegativePrompt}" TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>
      <Border IsVisible="{Binding Navigation.IsResultsView}">
        <views:ResultsView DataContext="{Binding Gallery}" />
      </Border>
      <Border IsVisible="{Binding Navigation.IsTrainingView}">
        <views:TrainingView DataContext="{Binding Training}" />
      </Border>
      <Border IsVisible="{Binding Navigation.IsAssetCreationView}">
        <views:AssetCreationView DataContext="{Binding AssetCreation}" />
      </Border>
      <Border IsVisible="{Binding Navigation.IsGenerationEnvironmentView}">
        <views:GenerationEnvironmentView />
      </Border>
      <Border IsVisible="{Binding Navigation.IsSettingsView}">
        <views:SettingsView />
      </Border>
      <Border IsVisible="{Binding Navigation.IsHelpView}">
        <Grid RowDefinitions="Auto,24,*">
          <StackPanel Spacing="8" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Text="{DynamicResource EidolonText184}" Classes="title" />
            <TextBlock Text="{DynamicResource EidolonText660}" Classes="muted" FontSize="13" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Stretch">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText185}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText186}" TextWrapping="Wrap" />
                  <TextBlock Text="{DynamicResource EidolonText187}" Classes="muted" />
                  <TextBlock Text="{DynamicResource EidolonText285}" Classes="muted" />
                  <TextBlock Text="{DynamicResource EidolonText190}" Classes="muted" />
                  <Button Content="{DynamicResource EidolonText581}" Command="{Binding Navigation.ShowGenerationEnvironmentCommand}" HorizontalAlignment="Left" />
                  <Button Command="{Binding Navigation.ShowEngineSettingsCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="{StaticResource EidolonIconEngine}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                      <TextBlock Text="{DynamicResource EidolonText593}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText188}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText189}" TextWrapping="Wrap" />
                  <TextBlock Text="{DynamicResource EidolonText480}" Classes="muted" />
                  <Button Command="{Binding Navigation.ShowGenerationCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="{StaticResource EidolonIconImage}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                      <TextBlock Text="{DynamicResource EidolonText106}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText476}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText477}" TextWrapping="Wrap" />
                  <TextBlock Text="{DynamicResource EidolonText479}" Classes="muted" />
                  <Button Command="{Binding Navigation.ShowEditingCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="{StaticResource EidolonIconEdit}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                      <TextBlock Text="{DynamicResource EidolonText456}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText661}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText662}" TextWrapping="Wrap" />
                  <Button Content="{DynamicResource EidolonText291}" Command="{Binding Navigation.ShowResultsCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText652}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText653}" TextWrapping="Wrap" />
                  <TextBlock Text="{DynamicResource EidolonText663}" Classes="muted" />
                  <Button Content="{DynamicResource EidolonText603}" Command="{Binding Navigation.ShowAssetCreationCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText191}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText192}" TextWrapping="Wrap" />
                  <TextBlock Text="{DynamicResource EidolonText193}" Classes="muted" />
                  <Button Command="{Binding Navigation.ShowTrainingCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="{StaticResource EidolonIconTraining}" Width="16" Height="16" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="1.7" />
                      <TextBlock Text="{DynamicResource EidolonText108}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText664}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText665}" TextWrapping="Wrap" />
                  <Button Content="{DynamicResource EidolonText110}" Command="{Binding Navigation.ShowSettingsCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="{DynamicResource EidolonText194}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{DynamicResource EidolonText195}" TextWrapping="Wrap" />
                  <TextBlock Text="{DynamicResource EidolonText196}" Classes="muted" />
                  <Button Command="{Binding Settings.OpenLogsCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Path Data="{StaticResource EidolonIconFolder}" Width="18" Height="18" Stretch="Uniform" Stroke="{ReflectionBinding $parent[Button].Foreground}" StrokeThickness="2.2" />
                      <TextBlock Text="{DynamicResource EidolonText174}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
      <Grid RowDefinitions="20,6,3,4,16,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Session.Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.Status}" TextWrapping="NoWrap" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Session.QueueSummary}" IsVisible="{Binding Session.HasPendingRequests}" Classes="muted" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="24,0,0,0" />
        </Grid>
        <ProgressBar Grid.Row="2" Value="{Binding Session.Percent}" IsIndeterminate="{Binding Session.Indeterminate}" IsVisible="{Binding Session.IsBusy}" Height="3" Foreground="{DynamicResource AccentBrush}" />
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Session.ActiveRequestTitle}" IsVisible="{Binding Session.IsBusy}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Session.ActiveRequestTitle}" TextWrapping="NoWrap" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Training.TrainingRemainingText}" IsVisible="{Binding Training.ShowTrainingRemainingTime}" Classes="muted" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="24,0,0,0" />
        </Grid>
        <Border Grid.Row="5" IsVisible="{Binding Session.HasError}" Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="7" Padding="12" Margin="0,8,0,0">
          <TextBlock Text="{Binding Session.Error}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" MaxHeight="100" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
